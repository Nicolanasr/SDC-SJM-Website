---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import EventsCalendar from '../components/EventsCalendar.astro';
import T from '../components/T.astro';
import { upcomingEvents } from '../data/events';
import { siteConfig } from '../data/siteConfig';
---

<Layout 
  title={`Troop Calendar & Saturday Meetings – ${siteConfig.groupName}`}
  description="Official calendar of weekly Saturday scout gatherings at Saint Jean Marc Byblos: times, schedule, age branches, and parent drop-off details."
>
  <PageHeader 
    badge="TROOP CALENDAR"
    badgeAr="الرزنامة والأنشطة الكشفية"
    title="Weekly Gatherings & Scout Calendar"
    titleAr="اللقاءات الأسبوعية ورزنامة الفوج"
    description="Every Saturday afternoon, our scouts and guides gather at the historic courtyard of Saint Jean Marc in Byblos for an afternoon of outdoor brotherhood, skills, and joy."
    descriptionAr="في كل بعد ظهر سبت، يلتقي كشافتنا ومرشداتنا في باحة كاتدرائية مار يوحنا مرقس الأثرية في جبيل لقضاء ساعات من روح الأخوة، اكتساب المهارات، والمغامرة في الهواء الطلق."
  />

  <section class="py-8 sm:py-16 max-w-6xl mx-auto px-2.5 sm:px-6 lg:px-8">
    <!-- Dynamic Interactive Calendar at Top -->
    <EventsCalendar />

    <!-- Detailed Events Cards Section -->
    <div class="space-y-6 sm:space-y-8">
      <div class="border-b border-stone-200 pb-4">
        <h2 class="text-xl sm:text-3xl font-black text-stone-900 tracking-tight">
          <T en="Weekly Saturday Schedule" ar="جدول اللقاء الأسبوعي المنتظم" />
        </h2>
        <p class="text-stone-600 text-xs sm:text-sm mt-1">
          <T 
            en="Every Saturday from 3:00 PM to 4:30 PM. Parents can drop off or stay in the courtyard." 
            ar="كل يوم سبت من الساعة ٣:٠٠ حتى ٤:٣٠ بعد الظهر في باحة مار يوحنا مرقس في جبيل القديمة." 
          />
        </p>
      </div>

      <div class="space-y-4 sm:space-y-6">
        {upcomingEvents.map((event) => (
          <div class="bg-white rounded-2xl sm:rounded-3xl p-3.5 sm:p-7 border border-stone-200 shadow-sm hover:shadow-md transition-all">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-5 sm:gap-6">
              
              <div class="space-y-3 flex-1">
                <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                  <span class={`text-xs uppercase font-bold tracking-wider px-3 py-1 rounded-full ${event.badgeColor}`}>
                    <T en={event.badge} ar={event.badgeAr} />
                  </span>
                  <span class="text-xs font-bold text-amber-800 bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200">
                    <T en={event.date} ar={event.dateAr} />
                  </span>
                  <span class="text-xs font-semibold text-stone-500">
                    {event.duration} • {event.ages}
                  </span>
                </div>

                <h3 class="text-xl sm:text-3xl font-black text-stone-900 tracking-tight">
                  <a href={`/events/${event.id}`} class="hover:text-cedar-800 transition-colors">
                    <T en={event.title} ar={event.titleAr} />
                  </a>
                </h3>
                <p class="text-xs sm:text-sm font-semibold text-stone-500">
                  <T en={event.subtitle} ar={event.subtitleAr} />
                </p>

                <p class="text-stone-600 text-xs sm:text-sm leading-relaxed pt-1">
                  <T en={event.description} ar={event.descriptionAr} />
                </p>

                <div class="pt-2 text-xs text-stone-600 flex items-center gap-2 font-medium">
                  <svg class="w-4 h-4 text-stone-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <span>
                    <T en={event.location} ar={event.locationAr} />
                  </span>
                </div>
              </div>

              <!-- Action Link to Event Detail Page -->
              <div class="lg:shrink-0 flex flex-col sm:flex-row lg:flex-col gap-3 w-full sm:w-auto">
                <a 
                  href={`/events/${event.id}`}
                  class="btn-scout-gold text-xs !py-3 !px-6 text-center whitespace-nowrap w-full sm:w-auto"
                >
                  <T en="View Schedule & What to Bring →" ar="تفاصيل اللقاء وما يحتاجه الكشاف ←" />
                </a>
              </div>

            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
