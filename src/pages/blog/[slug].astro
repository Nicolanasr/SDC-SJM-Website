---
import Layout from '../../layouts/Layout.astro';
import { blogPosts, type BlogPost } from '../../data/blog';
import { siteConfig } from '../../data/siteConfig';

export function getStaticPaths() {
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<Layout 
  title={`${post.title} – ${siteConfig.groupName}`}
  description={post.excerpt}
>
  <article class="py-12 sm:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <a 
      href="/blog" 
      class="inline-flex items-center gap-2 text-xs uppercase tracking-widest font-bold text-amber-700 hover:text-amber-900 mb-8 transition-colors"
    >
      <span>← Back to All Field Notes</span>
    </a>

    <!-- Header Metadata -->
    <header class="space-y-4 mb-8">
      <div class="flex items-center gap-3 text-xs font-bold uppercase tracking-wider text-stone-500">
        <span class="px-3 py-1 rounded-full bg-stone-200 text-stone-800 text-[11px]">
          {post.category}
        </span>
        <span>•</span>
        <span>{post.readTime}</span>
        <span>•</span>
        <span>{post.date}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-stone-900 tracking-tight leading-[1.12]">
        {post.title}
      </h1>

      <div class="flex items-center gap-3 pt-2 text-sm text-stone-600">
        <div class="w-10 h-10 rounded-full bg-stone-200 text-stone-800 font-bold flex items-center justify-center text-xs">
          {post.author.slice(0, 2)}
        </div>
        <div>
          <div class="font-bold text-stone-900">{post.author}</div>
          <div class="text-xs text-stone-500">{post.authorRole}</div>
        </div>
      </div>
    </header>

    <!-- Main Article Image -->
    <div class="rounded-3xl overflow-hidden aspect-[16/9] bg-stone-200 border border-stone-200 shadow-sm mb-12">
      <img 
        src={post.image} 
        alt={post.title} 
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Article Content Paragraphs -->
    <div class="prose prose-lg text-stone-800 space-y-6 text-base sm:text-lg leading-relaxed border-b border-stone-200 pb-12">
      <p class="font-medium text-xl text-stone-900 leading-snug">
        {post.excerpt}
      </p>

      {post.content.map(p => (
        <p class="text-stone-700 leading-relaxed">{p}</p>
      ))}
    </div>

    <!-- Bottom Actions / Share -->
    <footer class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <a href="/blog" class="btn-scout-outline text-xs uppercase tracking-wider">
        ← More Field Notes
      </a>

      <a 
        href={`https://wa.me/?text=${encodeURIComponent(`Check out this article from Scout Des Cèdres Saint Jean Marc: ${post.title}`)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-scout-gold text-xs uppercase tracking-wider flex items-center gap-2"
      >
        <span>Share on WhatsApp</span>
      </a>
    </footer>

  </article>
</Layout>
