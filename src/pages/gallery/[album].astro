---
import Layout from '../../layouts/Layout.astro';
import T from '../../components/T.astro';
import { galleryAlbums, galleryPhotos, type GalleryAlbum, type GalleryPhoto } from '../../data/gallery';
import { siteConfig } from '../../data/siteConfig';

export function getStaticPaths() {
  return galleryAlbums.map(album => ({
    params: { album: album.id },
    props: { album },
  }));
}

interface Props {
  album: GalleryAlbum;
}

const { album } = Astro.props;
const albumPhotos = galleryPhotos.filter(p => p.albumId === album.id);
---

<Layout 
  title={`${album.name} – Photo Album | ${siteConfig.groupName}`}
  titleAr={`${album.nameAr} – ألبوم صور | كشافة الأرز جبيل`}
  description={`${album.description} (${albumPhotos.length} photos)`}
  descriptionAr={`${album.descriptionAr} (${albumPhotos.length} صورة)`}
  image={album.coverImage}
>
  <!-- Album Header Banner -->
  <section class="bg-stone-900 text-sand-50 py-12 sm:py-20 border-b border-stone-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Back Link -->
      <a 
        href="/gallery" 
        class="inline-flex items-center gap-2 text-xs uppercase tracking-widest font-bold text-amber-400 hover:text-amber-300 mb-6 transition-colors"
      >
        <span>← <T en="Back to Gallery Overview" ar="العودة إلى معرض الصور الرئيسي" /></span>
      </a>

      <div class="max-w-3xl space-y-4">
        <div class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-stone-800 text-stone-300 border border-stone-700">
          <T en={`${albumPhotos.length} Photographs`} ar={`${albumPhotos.length} صورة توثيقية`} />
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
          <T en={album.name} ar={album.nameAr} />
        </h1>

        <p class="text-stone-300 text-base sm:text-lg leading-relaxed">
          <T en={album.description} ar={album.descriptionAr} />
        </p>
      </div>

    </div>
  </section>

  <!-- Album Photos Grid with Lightbox -->
  <section class="py-12 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="album-photos-grid">
      {albumPhotos.map((photo, index) => (
        <div 
          class="album-photo-item group cursor-pointer relative overflow-hidden rounded-3xl bg-stone-200 border border-stone-200 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md"
          data-full-img={photo.imageUrl}
          data-title={photo.title}
          data-title-ar={photo.titleAr}
          data-location={photo.location}
          data-location-ar={photo.locationAr}
          data-year={photo.year}
          data-index={index}
        >
          <div class="aspect-[4/3] w-full overflow-hidden bg-stone-100">
            <img 
              src={photo.imageUrl} 
              alt={photo.title} 
              loading="lazy" 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>

          <div class="p-4 bg-white flex items-center justify-between">
            <div>
              <h3 class="font-bold text-sm text-stone-900 group-hover:text-cedar-800 transition-colors">
                <T en={photo.title} ar={photo.titleAr} />
              </h3>
              <p class="text-xs text-stone-500 mt-0.5">
                <T en={photo.location} ar={photo.locationAr} /> • <span class="font-medium text-amber-700">{photo.year}</span>
              </p>
            </div>
            
            <div class="w-8 h-8 rounded-full bg-stone-100 group-hover:bg-cedar-800 group-hover:text-white transition-colors flex items-center justify-center shrink-0 text-stone-500">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
              </svg>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom navigation -->
    <div class="pt-12 mt-12 border-t border-stone-200 flex flex-col sm:flex-row items-center justify-between gap-4">
      <a 
        href="/gallery" 
        class="btn-scout-outline text-xs uppercase tracking-wider"
      >
        <T en="← Back to All Albums" ar="← العودة إلى الألبوم الرئيسي" />
      </a>
      
      <a 
        href="/#meeting"
        class="btn-scout-gold text-xs uppercase tracking-wider"
      >
        <T en="Join Us This Saturday" ar="انضم إلينا هذا السبت" />
      </a>
    </div>
  </section>

  <!-- Interactive Lightbox Modal -->
  <div 
    id="lightbox-modal" 
    class="fixed inset-0 z-50 bg-stone-950/95 backdrop-blur-md hidden flex items-center justify-center p-4"
  >
    <div class="relative max-w-5xl w-full flex flex-col items-center">
      <button 
        id="lightbox-close" 
        type="button" 
        class="absolute -top-12 right-0 text-stone-400 hover:text-white text-3xl font-bold p-2 cursor-pointer focus:outline-none"
        aria-label="Close image preview"
      >
        ✕
      </button>

      <div class="w-full max-h-[75vh] flex items-center justify-center overflow-hidden rounded-2xl shadow-2xl border border-stone-800 bg-stone-950">
        <img 
          id="lightbox-img" 
          src="" 
          alt="" 
          class="max-h-[75vh] w-auto max-w-full object-contain"
        />
      </div>

      <div class="w-full max-w-2xl text-center mt-4 space-y-1">
        <h4 id="lightbox-title" class="text-white text-base sm:text-xl font-bold"></h4>
        <p id="lightbox-subtitle" class="text-stone-400 text-xs sm:text-sm"></p>
      </div>

      <!-- Prev / Next Controls -->
      <button 
        id="lightbox-prev" 
        type="button" 
        class="absolute left-2 sm:-left-12 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-stone-900/80 hover:bg-amber-600 text-white flex items-center justify-center text-xl cursor-pointer transition-colors"
        aria-label="Previous photo"
      >
        ‹
      </button>
      <button 
        id="lightbox-next" 
        type="button" 
        class="absolute right-2 sm:-right-12 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-stone-900/80 hover:bg-amber-600 text-white flex items-center justify-center text-xl cursor-pointer transition-colors"
        aria-label="Next photo"
      >
        ›
      </button>
    </div>
  </div>

  <script>
    const photoItems = document.querySelectorAll('.album-photo-item');
    const modal = document.getElementById('lightbox-modal');
    const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const modalTitle = document.getElementById('lightbox-title');
    const modalSubtitle = document.getElementById('lightbox-subtitle');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    let currentIndex = 0;
    const items = Array.from(photoItems);

    function showPhoto(idx: number) {
      if (idx < 0) idx = items.length - 1;
      if (idx >= items.length) idx = 0;
      currentIndex = idx;

      const target = items[currentIndex] as HTMLElement;
      if (!target || !modalImg || !modalTitle || !modalSubtitle) return;

      const fullImg = target.getAttribute('data-full-img') || '';
      const isArabic = document.documentElement.lang === 'ar';
      const title = isArabic 
        ? target.getAttribute('data-title-ar') || target.getAttribute('data-title') 
        : target.getAttribute('data-title');
      const location = isArabic 
        ? target.getAttribute('data-location-ar') || target.getAttribute('data-location') 
        : target.getAttribute('data-location');
      const year = target.getAttribute('data-year') || '';

      modalImg.src = fullImg;
      modalImg.alt = title || '';
      modalTitle.textContent = title || '';
      modalSubtitle.textContent = `${location} • ${year}`;
    }

    photoItems.forEach((item, idx) => {
      item.addEventListener('click', () => {
        showPhoto(idx);
        modal?.classList.remove('hidden');
      });
    });

    closeBtn?.addEventListener('click', () => modal?.classList.add('hidden'));
    prevBtn?.addEventListener('click', () => showPhoto(currentIndex - 1));
    nextBtn?.addEventListener('click', () => showPhoto(currentIndex + 1));

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.classList.add('hidden');
    });

    document.addEventListener('keydown', (e) => {
      if (modal?.classList.contains('hidden')) return;
      if (e.key === 'Escape') modal.classList.add('hidden');
      if (e.key === 'ArrowLeft') showPhoto(currentIndex - 1);
      if (e.key === 'ArrowRight') showPhoto(currentIndex + 1);
    });
  </script>
</Layout>
