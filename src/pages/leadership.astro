---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import LeadershipTree from '../components/LeadershipTree.astro';
import T from '../components/T.astro';
import { siteConfig } from '../data/siteConfig';
---

<Layout 
  title={`Leadership Hierarchy Tree – ${siteConfig.groupName}`}
  description="Explore the leadership hierarchy tree of Scout Des Cèdres Groupe Saint Jean Marc Byblos: Mourched, Chef de Groupe, Conseil de Groupe, and Unit Leaders."
>
  <PageHeader 
    badge="CHAIN OF LEADERSHIP"
    badgeAr="الهيكلية والقيادة الكشفية"
    title="Group Leadership Hierarchy Tree"
    titleAr="الهيكلية القيادية ومجلس الفوج"
    description="100% volunteer-driven. Our chefs, cheftaines, and council members dedicate their time every week to guide the youth of Saint Jean Marc."
    descriptionAr="فوج تطوعي ١٠٠٪. يكرس قادتنا ومجلس الفوج وقتهم كل أسبوع لمرافقة وتنشئة أجيال مار يوحنا مرقس."
  />

  <!-- Interactive Hierarchy Tree Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- The Tree Component -->
    <LeadershipTree />
  </section>

  <!-- Leadership Philosophy & Formation Note -->
  <section class="pb-16 sm:pb-24 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-[#FAF7F2] rounded-3xl p-6 sm:p-10 lg:p-12 border border-stone-200/90 shadow-sm space-y-5 sm:space-y-6">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-cedar-900">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
        <span>
          <T en="Formation & Leader Pedagogy" ar="التدريب والتنشئة القيادية" />
        </span>
      </div>

      <h3 class="font-serif text-xl sm:text-3xl font-bold text-cedar-950">
        <T en="How Leaders Are Formed" ar="كيف يُصنع القادة في فوجنا" />
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 text-xs sm:text-sm text-stone-700 leading-relaxed">
        <p>
          <T 
            en="In our scout tradition, leadership is not a privilege—it is an act of service (Servir). The vast majority of our chefs began in the group as young children in the Louveteaux or Jeannettes, taking their promise at the altar of Saint Jean Marc before growing into confident mentors." 
            ar="في تقليدنا الكشفي، القيادة ليست منصباً بل هي خدمة وبذل (Servir). بدأ معظم قادتنا وقائداتنا مسيرتهم كأطفال في سرب الجراميز والزهرات، وأدّوا وعدهم الكشفي أمام مذبح كاتدرائية مار يوحنا مرقس حتى وصلوا إلى مواقع المسؤولية." 
          />
        </p>
        <p>
          <T 
            en="Before taking charge of any unit, every leader completes rigorous pedagogical, psychological, and outdoor first-aid training camps, adhering strictly to the safety standards of the Lebanese Scout Federation." 
            ar="قبل تولي مسؤولية أي وحدة كشفية، يخضع كل قائد وقائدة لمخيمات تدريبية مكثفة تشمل أصول التنشئة التربوية، السلامة النفسية والجسدية، والإسعافات الأولية المعتمدة وفق معايير اتحاد كشاف لبنان." 
          />
        </p>
      </div>

      <div class="pt-4 border-t border-stone-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="text-xs sm:text-sm text-stone-600 font-medium">
          <T 
            en="Interested in joining the leadership maitrise or parent support committee?" 
            ar="هل ترغب في التطوع مع الهيئة القيادية أو لجنة أولياء الأمور؟" 
          />
        </div>
        <a 
          href={`https://wa.me/${siteConfig.contact.phoneRaw}?text=${encodeURIComponent('Hello! I would like to volunteer or learn more about joining the Saint Jean Marc leadership team.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-scout-primary text-xs uppercase tracking-wider whitespace-nowrap w-full sm:w-auto text-center justify-center !py-2.5 !px-5"
        >
          <T en="Message Chef de Groupe" ar="تواصل مع قيادة الفوج" />
        </a>
      </div>
    </div>
  </section>

  <!-- Leadership FAQ Section -->
  <section class="pb-16 sm:pb-24 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="space-y-6 sm:space-y-8">
      <div class="text-center space-y-2">
        <span class="inline-block px-3 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-widest bg-stone-100 text-stone-700 border border-stone-300">
          <T en="LEADERSHIP & VOLUNTEERING FAQ" ar="الأسئلة الشائعة حول القيادة والتطوع" />
        </span>
        <h3 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900">
          <T en="Frequently Asked Questions About Our Leadership" ar="أسئلة شائعة حول قيادة الفوج والمسؤوليات" />
        </h3>
        <p class="text-xs sm:text-sm text-stone-600 max-w-lg mx-auto">
          <T 
            en="Clear, transparent answers about our 100% volunteer model, safety standards, and leader formation." 
            ar="إجابات شفافة وواضحة حول نموذج التطوع، معايير السلامة، وتدريب القادة في الفوج." 
          />
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        
        <!-- FAQ Item 1 -->
        <div class="bg-white rounded-2xl p-5 sm:p-6 border border-stone-200/90 shadow-xs space-y-2 hover:border-cedar-800 transition-colors">
          <h4 class="font-bold text-sm sm:text-base text-stone-900 flex items-start gap-2">
            <span class="text-amber-600 font-bold shrink-0">Q.</span>
            <span><T en="Are our chefs and leaders paid or volunteers?" ar="هل قادة الفوج متطوعون أم يتقاضون أجراً؟" /></span>
          </h4>
          <p class="text-xs sm:text-sm text-stone-600 leading-relaxed pl-5 rtl:pl-0 rtl:pr-5">
            <T 
              en="100% unpaid volunteers. Every chef, cheftaine, and council member donates their time on Saturdays, weekends, and summer camps freely out of love for Byblos youth and the scout promise." 
              ar="متطوعون ١٠٠٪ دون أي مقابل مادي. يكرس كل قائد وقائدة وقتهم في لقاءات السبت والمخيمات حباً بأجيال جبيل والتزاماً بوعدهم الكشفي." 
            />
          </p>
        </div>

        <!-- FAQ Item 2 -->
        <div class="bg-white rounded-2xl p-5 sm:p-6 border border-stone-200/90 shadow-xs space-y-2 hover:border-cedar-800 transition-colors">
          <h4 class="font-bold text-sm sm:text-base text-stone-900 flex items-start gap-2">
            <span class="text-amber-600 font-bold shrink-0">Q.</span>
            <span><T en="What first aid and safety certifications do leaders hold?" ar="ما هي مؤهلات السلامة والإسعافات الأولية لدى القادة؟" /></span>
          </h4>
          <p class="text-xs sm:text-sm text-stone-600 leading-relaxed pl-5 rtl:pl-0 rtl:pr-5">
            <T 
              en="Every unit has leaders certified in first aid following Lebanese Red Cross training standards, alongside mountain risk management and youth safety protocols." 
              ar="تضم كل وحدة كشفية قادة حاصلين على شهادات إسعافات أولية معتمدة وفق معايير الصليب الأحمر اللبناني وإدارة مخاطر الطبيعة الجبلية." 
            />
          </p>
        </div>

        <!-- FAQ Item 3 -->
        <div class="bg-white rounded-2xl p-5 sm:p-6 border border-stone-200/90 shadow-xs space-y-2 hover:border-cedar-800 transition-colors">
          <h4 class="font-bold text-sm sm:text-base text-stone-900 flex items-start gap-2">
            <span class="text-amber-600 font-bold shrink-0">Q.</span>
            <span><T en="How do leaders balance scout duties with university or work?" ar="كيف يوفق القادة بين دراستهم الجامعية ووظائفهم وخدمة الفوج؟" /></span>
          </h4>
          <p class="text-xs sm:text-sm text-stone-600 leading-relaxed pl-5 rtl:pl-0 rtl:pr-5">
            <T 
              en="Scouting teaches real-world organization. Each section is co-led by a Unit Chief and Assistants, ensuring smooth continuity during exam seasons and work demands." 
              ar="الكشفية مدرسة في تنظيم الوقت. تقاد كل وحدة بفريق مشترك من قائد ومساعدين، مما يضمن استمرارية النشاط بسلاسة أثناء فترات الامتحانات الجامعية." 
            />
          </p>
        </div>

        <!-- FAQ Item 4 -->
        <div class="bg-white rounded-2xl p-5 sm:p-6 border border-stone-200/90 shadow-xs space-y-2 hover:border-cedar-800 transition-colors">
          <h4 class="font-bold text-sm sm:text-base text-stone-900 flex items-start gap-2">
            <span class="text-amber-600 font-bold shrink-0">Q.</span>
            <span><T en="Can parents volunteer or get involved in troop support?" ar="هل يمكن لأولياء الأمور التطوع في دعم أنشطة الفوج؟" /></span>
          </h4>
          <p class="text-xs sm:text-sm text-stone-600 leading-relaxed pl-5 rtl:pl-0 rtl:pr-5">
            <T 
              en="Yes! Parents actively participate through the Parent Committee (Comité des Parents), camp logistics, first-aid support, and specialist craft workshops." 
              ar="نعم بكل سرور! يشارك الأهل عبر لجنة أولياء الأمور، ومساندة لوجستيات المخيمات الصيفية، وتقديم ورش تدريبية تخصصية للفتية." 
            />
          </p>
        </div>

      </div>
    </div>
  </section>
</Layout>
