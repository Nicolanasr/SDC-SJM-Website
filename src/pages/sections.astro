---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import T from '../components/T.astro';
import { sectionsData } from '../data/sections';
import { siteConfig } from '../data/siteConfig';
---

<Layout 
  title={`Sections & Branches – ${siteConfig.groupName}`}
  description="Explore the three scout branches at Scout Des Cèdres Saint Jean Marc Byblos: Louveteaux & Jeannettes (جراميز وزهرات, ages 4-11), Scouts & Guides (كشافة ومرشدات, ages 11-16), and Routiers & Caravelles (جوالة ومنجدات, ages 16-24)."
>
  <PageHeader 
    badge="OUR THREE BRANCHES"
    badgeAr="فروع الفوج الكشفي الثلاثة"
    title="A section for every age"
    titleAr="قسم مخصص لكل فئة عمرية"
    description="Each branch is tailored to nurture character, friendship, autonomy, and outdoor woodcraft at every stage of youth in Byblos."
    descriptionAr="تنشئة متكاملة تهدف إلى صقل الشخصية، روح الأخوة، الاستقلالية، ومهارات ريادة الخلاء في كل مرحلة عمرية."
  />

  <!-- Detailed Units List (Magazine Showcase) -->
  <section class="py-10 sm:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16">
    {sectionsData.map((section, idx) => (
      <article 
        id={section.id} 
        class="scroll-mt-28 rounded-3xl overflow-hidden border border-stone-200/90 bg-white shadow-sm hover:shadow-md transition-shadow"
      >
        <!-- Wide Top Image Banner -->
        <div class="relative h-64 sm:h-80 md:h-96 w-full overflow-hidden bg-stone-900">
          <img 
            src={section.image} 
            alt={section.name} 
            class="w-full h-full object-cover opacity-90 transition-transform duration-700 hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/85 via-stone-950/40 to-transparent"></div>
          
          <div class="absolute bottom-4 left-4 right-4 sm:bottom-6 sm:left-8 sm:right-8 flex flex-wrap items-end justify-between gap-3 text-white">
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class={`px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${section.badgeColor}`}>
                  <T en={section.ageRange} ar={section.arabicAgeRange} />
                </span>
                <span class="text-xs uppercase tracking-wider font-bold bg-amber-400/20 text-amber-300 border border-amber-400/40 px-3 py-1 rounded-full backdrop-blur-sm">
                  <T en={`Motto: ${section.motto}`} ar={`الشعار: ${section.arabicMotto}`} />
                </span>
              </div>
              <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black tracking-tight drop-shadow-sm">
                <T en={section.name} ar={section.arabicName} />
              </h2>
              <p class="text-xs sm:text-sm text-stone-300 font-medium mt-1">
                {section.frenchName}
              </p>
            </div>

            <div class="hidden sm:inline-flex items-center gap-2 text-xs font-semibold bg-stone-900/80 backdrop-blur-md px-3.5 py-2 rounded-xl border border-stone-700/60 text-stone-200">
              <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>
                <T en={section.meetingTime} ar={section.arabicMeetingTime} />
              </span>
            </div>
          </div>
        </div>

        <!-- Body Details Grid -->
        <div class="p-6 sm:p-10 lg:p-12 space-y-8">
          
          <!-- Narrative Lead -->
          <div class="max-w-4xl space-y-3">
            <p class="text-stone-700 text-base sm:text-lg leading-relaxed">
              <T en={section.description} ar={section.arabicDescription} />
            </p>
            <div class="sm:hidden inline-flex items-center gap-2 text-xs font-semibold bg-stone-100 px-3 py-2 rounded-xl border border-stone-200 text-stone-700">
              <svg class="w-4 h-4 text-cedar-800 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>
                <T en={section.meetingTime} ar={section.arabicMeetingTime} />
              </span>
            </div>
          </div>

          <!-- Two-Column Cards: Parent Peace of Mind vs Skills & Activities -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
            
            <!-- Parent Peace of Mind Box -->
            <div class="rounded-2xl p-5 sm:p-6 bg-emerald-50/50 border border-emerald-100/80 space-y-3">
              <div class="flex items-center gap-2.5 text-emerald-950 font-bold text-sm sm:text-base">
                <span class="w-7 h-7 rounded-lg bg-emerald-600 text-white flex items-center justify-center shrink-0 text-sm">
                  🛡️
                </span>
                <h3>
                  <T en="Parent Peace of Mind" ar="راحة واطمئنان الأهل" />
                </h3>
              </div>
              <ul class="lang-en space-y-2 text-xs sm:text-sm text-stone-700">
                {section.parentHighlights.map(item => (
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-700 font-bold shrink-0 mt-0.5">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <ul class="lang-ar space-y-2 text-xs sm:text-sm text-stone-700">
                {section.arabicParentHighlights.map(item => (
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-700 font-bold shrink-0 mt-0.5">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Key Skills & Activities Box -->
            <div class="rounded-2xl p-5 sm:p-6 bg-amber-50/50 border border-amber-100/80 space-y-3">
              <div class="flex items-center gap-2.5 text-amber-950 font-bold text-sm sm:text-base">
                <span class="w-7 h-7 rounded-lg bg-amber-600 text-white flex items-center justify-center shrink-0 text-sm">
                  🏕️
                </span>
                <h3>
                  <T en="What Scouts Learn & Do" ar="الأنشطة والمهارات المكتسبة" />
                </h3>
              </div>
              <ul class="lang-en space-y-2 text-xs sm:text-sm text-stone-700">
                {section.activities.map(activity => (
                  <li class="flex items-start gap-2">
                    <span class="text-amber-700 font-bold shrink-0 mt-0.5">✦</span>
                    <span>{activity}</span>
                  </li>
                ))}
              </ul>
              <ul class="lang-ar space-y-2 text-xs sm:text-sm text-stone-700">
                {section.arabicActivities.map(activity => (
                  <li class="flex items-start gap-2">
                    <span class="text-amber-700 font-bold shrink-0 mt-0.5">✦</span>
                    <span>{activity}</span>
                  </li>
                ))}
              </ul>
            </div>

          </div>

          <!-- Action Buttons Bar -->
          <div class="pt-4 border-t border-stone-100 flex flex-col sm:flex-row items-center justify-between gap-3">
            <span class="text-xs text-stone-500 font-medium">
              <T 
                en="Weekly gatherings take place at Saint Jean Marc Byblos courtyard." 
                ar="تقام الأنشطة الأسبوعية في باحة كاتدرائية مار يوحنا مرقس في جبيل القديمة." 
              />
            </span>
            <div class="flex flex-wrap items-center gap-2.5 w-full sm:w-auto">
              <a 
                href={`https://wa.me/${siteConfig.contact.phoneRaw}?text=${encodeURIComponent(`Hello! I would like to inquire about registering in ${section.name}.`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-scout-gold text-xs uppercase tracking-wider !py-2.5 !px-5 flex items-center justify-center gap-2 w-full sm:w-auto"
              >
                <span>💬</span>
                <T en={`Inquire on WhatsApp`} ar={`استفسار عبر واتساب`} />
              </a>
              <a 
                href="/#meeting"
                class="btn-scout-outline text-xs uppercase tracking-wider !py-2.5 !px-5 text-center w-full sm:w-auto"
              >
                <T en="Visit This Saturday" ar="تفضل بزيارتنا هذا السبت" />
              </a>
            </div>
          </div>

        </div>
      </article>
    ))}
  </section>

  <!-- Bottom CTA -->
  <section class="pb-16 sm:pb-24 max-w-4xl mx-auto px-4 text-center space-y-3 sm:space-y-4">
    <h3 class="text-2xl sm:text-3xl font-black text-stone-900 tracking-tight">
      <T en="Not sure which section fits your child?" ar="لست متأكداً من القسم الأنسب لطفلك؟" />
    </h3>
    <p class="text-stone-600 text-xs sm:text-base max-w-xl mx-auto leading-relaxed">
      <T 
        en="Visit us this Saturday between 3:00 PM and 4:30 PM at the Saint Jean Marc courtyard in Byblos. Our chefs will gladly welcome your family and answer every question." 
        ar="تفضلوا بزيارتنا هذا السبت بين ٣:٠٠ و ٤:٣٠ بعد الظهر في باحة مار يوحنا مرقس في جبيل. سيسعد قادتنا باستقبال عائلتكم والإجابة على استفساراتكم." 
      />
    </p>
    <div class="pt-2">
      <a href="/#contact" class="btn-scout-primary text-xs uppercase tracking-wider inline-block">
        <T en="Contact Group Leaders" ar="تواصل مع قادة الفوج" />
      </a>
    </div>
  </section>
</Layout>
