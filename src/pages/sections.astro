---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import T from '../components/T.astro';
import { sectionsData } from '../data/sections';
import { siteConfig } from '../data/siteConfig';
import { Compass, Flame, Shield, Users, MapPin, Sparkles, ArrowRight } from 'lucide-astro';

// Distinctive theme styling per branch to give authentic scout personality
const branchStyles = [
  {
    themeBg: "bg-amber-950/5 border-amber-300/80",
    badgeTheme: "bg-amber-600 text-white",
    cardAccent: "border-l-4 border-amber-600",
    iconColor: "text-amber-600",
    glow: "from-amber-500/20 to-orange-500/0",
    mascot: "🐺",
    subUnits: [
      { name: "Louveteaux (الجراميز)", target: "Boys ages 4–11", role: "Led by Akela & Baloo in the jungle pack" },
      { name: "Jeannettes (الزهرات)", target: "Girls ages 4–11", role: "Friendship, creativity, and joyful outdoor discovery" },
    ],
    highlights: [
      { icon: "🌲", title: "100% Screen-Free Saturdays", titleAr: "أنشطة نقية خالية من الشاشات", desc: "Running, climbing, laughter, and real camaraderie in the ancient courtyard." },
      { icon: "🪢", title: "Early Woodcraft & Knots", titleAr: "عقد كشفية ومهارات يدوية", desc: "Learning real knots, outdoor crafts, and taking care of their own backpack." },
      { icon: "🤝", title: "Caring & Sharing (De notre mieux)", titleAr: "روح الأخوة والمشاركة", desc: "Growing in empathy, teamwork, and confidence under loving, attentive leaders." },
    ]
  },
  {
    themeBg: "bg-emerald-950/5 border-emerald-300/80",
    badgeTheme: "bg-emerald-700 text-white",
    cardAccent: "border-l-4 border-emerald-700",
    iconColor: "text-emerald-700",
    glow: "from-emerald-500/20 to-teal-500/0",
    mascot: "🏕️",
    subUnits: [
      { name: "Scouts (الكشافة)", target: "Boys ages 11–16", role: "Autonomous patrols (patrouilles) exploring mountain wilderness" },
      { name: "Guides (المرشدات)", target: "Girls ages 11–16", role: "Sisterhood, campcraft mastery, pioneering, and leadership" },
    ],
    highlights: [
      { icon: "🪵", title: "Froissartage (Zero Nails)", titleAr: "منشآت خشبية بدون أي مسمار", desc: "Building towers, bridges, and camp kitchens with timber logs and sisal rope." },
      { icon: "🧭", title: "Topographic Mountain Treks", titleAr: "مسارات الجبال والبوصلة", desc: "Navigating rugged Lebanese valleys with topographic maps and compass." },
      { icon: "🔥", title: "10-Day Camp Under Canvas", titleAr: "المخيم الصيفي الكبير (١٠ أيام)", desc: "Wood stove cooking, evening campfire legends, and sleeping under mountain stars." },
    ]
  },
  {
    themeBg: "bg-red-950/5 border-red-300/80",
    badgeTheme: "bg-red-700 text-white",
    cardAccent: "border-l-4 border-red-700",
    iconColor: "text-red-700",
    glow: "from-red-500/20 to-rose-500/0",
    mascot: "⛰️",
    subUnits: [
      { name: "Routiers (الجوالة)", target: "Young Men ages 16–24", role: "Clan expeditions, disaster relief, and mountain journeys" },
      { name: "Caravelles (المنجدات)", target: "Young Women ages 16–24", role: "Humanitarian impact, self-reflection, and community leadership" },
    ],
    highlights: [
      { icon: "🥾", title: "The Open Road (LMT Treks)", titleAr: "مسارات درب الجبل الطويلة", desc: "Long distance backpacking journeys across Lebanon's highest ridges." },
      { icon: "❤️", title: "Civic & Emergency Service", titleAr: "خدمة المجتمع والإغاثة", desc: "Concrete aid to vulnerable families and active parish social solidarity." },
      { icon: "🎖️", title: "Leadership In Action", titleAr: "مدرسة صناعة القادة", desc: "Mentoring younger sections, organizing large-scale logistics, and public speaking." },
    ]
  }
];

const branchFaqs = [
  // 1. Louveteaux & Jeannettes (4–11)
  [
    {
      q: "Can a 4 or 5-year-old attend without parents staying?",
      qAr: "هل يستطيع طفل بعمر ٤ أو ٥ سنوات البقاء دون مرافقة والديه؟",
      a: "Yes! Our Cheftaines and Chefs provide gentle, warm 1-on-1 care, assisting with bathroom breaks, water bottles, and handwashing. Parents are also welcome to observe from the courtyard benches.",
      aAr: "نعم بكل تأكيد! توفر القائدات والقادة رعاية حنونة ومرافقة مباشرة في كل التفاصيل (شرب الماء، غسل اليدين والمساعدة). ويمكن للأهل البقاء في مقاعد الباحة للمراقبة والاطمئنان."
    },
    {
      q: "What should my child wear for their first Saturday?",
      qAr: "ماذا يرتدي طفلي في أول سبت يشارك فيه؟",
      a: "Just comfortable sports clothes and running sneakers. Official uniform and neckerchief are only ordered after a 3-week trial period once your child feels right at home.",
      aAr: "ملابس رياضية مريحة وحذاء رياضي فقط. ولا نطلب الزي الكشفي أو المنديل إلا بعد فترة تجربة لثلاثة أسابيع حين يشعر الطفل بأنه في بيته الثاني."
    },
    {
      q: "How does scouting fit with school homework and other activities?",
      qAr: "كيف يوفق طفلي الصغير بين الكشافة وفروض المدرسة والتمارين الرياضية الأخرى؟",
      a: "Our meetings are strictly 90 minutes on Saturday afternoons (3:00 to 4:30 PM). This leaves mornings and Sundays completely free for school studies, sports matches, and family outings. In fact, scouting helps young children learn independence, listening skills, and bedtime routine discipline that directly benefit their school performance.",
      aAr: "لقاءاتنا محددة بـ ٩٠ دقيقة فقط بعد ظهر السبت (من ٣:٠٠ إلى ٤:٣٠). وهذا يترك فترات الصباح ويوم الأحد كاملاً للدروس والواجبات وتمارين الرياضة والمشاوير العائلية. بل إن الكشفية تكسب الطفل استقلالية وانضباطاً وتركيزاً ينعكس إيجاباً على نتائجه المدرسية."
    }
  ],
  // 2. Scouts & Guides (11–16)
  [
    {
      q: "How are summer camps supervised and kept safe?",
      qAr: "كيف تتم مراقبة الأمان والسلامة في المخيم الصيفي الجبلي؟",
      a: "Every campsite has Red Cross certified leaders on duty, strict perimeter boundaries, continuous night watches, and an established medical protocol with nearby regional centers.",
      aAr: "يخضع كل مخيم لحراسة ليلية مستمرة، مسعفين معتمدين وفق معايير الصليب الأحمر، ومحيط محدد بدقة مع خطة طوارئ وتنسيق مع أقرب مركز صحي."
    },
    {
      q: "Does scouting interfere with school exams and homework?",
      qAr: "هل يتعارض النشاط الكشفي مع الامتحانات والدراسة المدرسية؟",
      a: "Meetings are only 90 minutes on Saturdays, teaching youth time management and stress relief. During official exam periods, activities are lightened to support students.",
      aAr: "اللقاء مدته ٩٠ دقيقة فقط بعد ظهر السبت ويساعد الفتية على تجديد نشاطهم النفسي والابتعاد عن ضغط الشاشات. وفي فترات الامتحانات الرسمية يتم تكييف البرنامج لدعم الطلاب."
    }
  ],
  // 3. Routiers & Caravelles (16–24)
  [
    {
      q: "Can someone join at age 17 or 20 without prior scout experience?",
      qAr: "هل يمكن الانضمام في سن ١٧ أو ٢٠ دون أي تجربة كشفية سابقة؟",
      a: "Absolutely. Many young adults join for mountain expeditions, brotherhood, and community service. You are paired with experienced peers who guide you seamlessly.",
      aAr: "نعم بالتأكيد. ينضم العديد من شباب الجامعات من أجل مسارات المشي الجبلية، الخدمة الإنسانية، والصحبة الصادقة. ويتم الترحيب بهم ومرافقتهم خطوة بخطوة."
    },
    {
      q: "What leadership and university credentials do rovers gain?",
      qAr: "ما هي المهارات والشهادات التي يكتسبها الجوالة لمسيرتهم الجامعية والمهنية؟",
      a: "Logistics planning, team mediation, outdoor first-aid certification, crisis response, and public speaking—credentials that top universities and employers actively look for.",
      aAr: "إدارة اللوجستيات والمشاريع، الإسعافات الأولية المعتمدة، حل النزاعات، والقيادة الميدانية، وهي خبرات موثقة تثري السيرة الذاتية لدى الجامعات وأرباب العمل."
    }
  ]
];
---

<Layout 
  title={`Sections & Branches – ${siteConfig.groupName} Byblos`}
  titleAr="الفروع والمراحل الكشفية – كشافة الأرز جبيل"
  description="Explore the three scout branches at Scout Des Cèdres Saint Jean Marc Byblos: Louveteaux & Jeannettes (4–11), Scouts & Guides (11–16), and Routiers & Caravelles (16–24). Weekly Saturday meetings in Byblos."
  descriptionAr="تعرفوا على فروع فوج القديس يوحنا مرقس جبيل: الجراميز والزهرات (٤–١١ سنة)، الكشافة والمرشدات (١١–١٦ سنة)، والجوالة والمنجدات (١٦–٢٤ سنة). لقاءات أسبوعية كل سبت."
>
  <PageHeader 
    badge="THE THREE BRANCHES OF SCOUTING"
    badgeAr="فروع الفوج الكشفي الثلاثة"
    title="Not an after-school daycare. A lifelong brotherhood and sisterhood in the wild."
    titleAr="ليست مجرد نادٍ عادي.. بل مدرسة للحياة في قلب الطبيعة."
    description="From first outdoor games at age 4 to high mountain expeditions at age 20, discover where your child's journey begins."
    descriptionAr="من أولى ألعاب الحركة في سن الرابعة حتى مسارات القمم الجبلية في العشرين.. هنا تبدأ المغامرة الحقيقية."
  />

  <!-- Quick Branch Jump Bar -->
  <section class="max-w-7xl mx-auto px-2.5 sm:px-6 lg:px-8 -mt-6 sm:-mt-8 mb-8 sm:mb-16">
    <div class="bg-white rounded-2xl sm:rounded-full p-1.5 sm:p-2 border border-stone-200/90 shadow-md flex flex-wrap items-center justify-around gap-1.5 sm:gap-2">
      <a 
        href="#jaramiz-zahrat" 
        class="flex-1 min-w-[140px] sm:min-w-[200px] text-center px-3 py-2 sm:px-4 sm:py-2.5 rounded-xl sm:rounded-full hover:bg-amber-50 text-stone-800 hover:text-amber-900 transition-colors font-bold text-xs sm:text-sm flex items-center justify-center gap-1.5 sm:gap-2"
      >
        <span class="text-sm sm:text-base">🐺</span>
        <span><T en="Ages 4–11: Cubs & Jeannettes" ar="٤–١١ سنة: جراميز وزهرات" /></span>
      </a>
      <span class="hidden sm:inline text-stone-300">•</span>
      <a 
        href="#kechefe-mourchidet" 
        class="flex-1 min-w-[140px] sm:min-w-[200px] text-center px-3 py-2 sm:px-4 sm:py-2.5 rounded-xl sm:rounded-full hover:bg-emerald-50 text-stone-800 hover:text-emerald-950 transition-colors font-bold text-xs sm:text-sm flex items-center justify-center gap-1.5 sm:gap-2"
      >
        <span class="text-sm sm:text-base">🏕️</span>
        <span><T en="Ages 11–16: Scouts & Guides" ar="١١–١٦ سنة: كشافة ومرشدات" /></span>
      </a>
      <span class="hidden sm:inline text-stone-300">•</span>
      <a 
        href="#jouwele-mounjidet" 
        class="flex-1 min-w-[140px] sm:min-w-[200px] text-center px-3 py-2 sm:px-4 sm:py-2.5 rounded-xl sm:rounded-full hover:bg-red-50 text-stone-800 hover:text-red-950 transition-colors font-bold text-xs sm:text-sm flex items-center justify-center gap-1.5 sm:gap-2"
      >
        <span class="text-sm sm:text-base">⛰️</span>
        <span><T en="Ages 16–24: Rovers & Caravelles" ar="١٦–٢٤ سنة: جوالة ومنجدات" /></span>
      </a>
    </div>
  </section>

  <!-- Detailed Units (High-Energy Magazine Showcase) -->
  <section class="max-w-7xl mx-auto px-2.5 sm:px-6 lg:px-8 space-y-10 sm:space-y-20 pb-16 sm:pb-24">
    {sectionsData.map((section, idx) => {
      const style = branchStyles[idx] || branchStyles[0];
      return (
        <article 
          id={section.id} 
          class="scroll-mt-24 rounded-2xl sm:rounded-3xl overflow-hidden border-2 bg-white shadow-md hover:shadow-xl transition-all duration-300"
          style={`border-color: ${section.accentHex}40;`}
        >
          <!-- Wide Atmospheric Top Image Banner -->
          <div class="relative min-h-[260px] sm:h-96 w-full overflow-hidden bg-stone-900 group">
            <img 
              src={section.image} 
              alt={section.name} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/40 to-transparent"></div>
            
            <!-- Banner Content Overlay -->
            <div class="absolute bottom-3 left-3 right-3 sm:bottom-8 sm:left-8 sm:right-8 flex flex-col md:flex-row md:items-end justify-between gap-3 sm:gap-4 text-white">
              <div class="space-y-1.5 sm:space-y-2">
                <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                  <span class={`inline-flex items-center gap-1 sm:gap-1.5 px-2.5 py-0.5 sm:px-3.5 sm:py-1 rounded-full text-[10px] sm:text-xs font-black uppercase tracking-wider shadow-sm ${style.badgeTheme}`}>
                    <span>{style.mascot}</span>
                    <T en={section.ageRange} ar={section.arabicAgeRange} />
                  </span>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider bg-black/60 backdrop-blur-md border border-white/20 text-gold-300">
                    <T en={`Motto: ${section.motto}`} ar={`الشعار: ${section.arabicMotto}`} />
                  </span>
                </div>

                <h2 class="text-2xl sm:text-5xl font-black tracking-tight drop-shadow-md">
                  <T en={section.name.split('(')[0].trim()} ar={section.arabicName.split('(')[0].trim()} />
                </h2>
                <p class="text-xs sm:text-sm text-sand-200 font-medium">
                  {section.frenchName} • <T en="Scout Des Cèdres Saint Jean Marc Byblos" ar="كشافة الأرز - فوج القديس يوحنا مرقس" />
                </p>
              </div>

              <!-- Saturday Meeting Pill -->
              <div class="inline-flex items-center gap-1.5 sm:gap-2 px-3 py-1.5 sm:px-4 sm:py-2.5 rounded-xl sm:rounded-2xl bg-stone-900/80 backdrop-blur-md border border-stone-700/80 text-[11px] sm:text-xs font-bold text-sand-100 self-start md:self-auto">
                <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span><T en="Every Saturday 3:00 – 4:30 PM" ar="كل سبت ٣:٠٠ – ٤:٣٠ بعد الظهر" /></span>
              </div>
            </div>
          </div>

          <!-- Main Body -->
          <div class="p-3.5 sm:p-8 lg:p-12 space-y-6 sm:space-y-10">
            
            <!-- Narrative Lead -->
            <div class="max-w-4xl space-y-2 sm:space-y-3">
              <h3 class="text-lg sm:text-2xl font-black text-stone-900 tracking-tight">
                <T en="The Spirit & The Adventure" ar="روح المغامرة في هذا الفرع" />
              </h3>
              <p class="text-stone-700 text-sm sm:text-lg leading-relaxed font-sans">
                <T en={section.description} ar={section.arabicDescription} />
              </p>
            </div>

            <!-- Two Sub-Units Cards (Boys Branch & Girls Branch) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4 pt-1 sm:pt-2">
              {style.subUnits.map(unit => (
                <div class="p-3.5 sm:p-5 rounded-xl sm:rounded-2xl bg-stone-50 border border-stone-200/80 flex items-start gap-3 sm:gap-4">
                  <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white border border-stone-200 flex items-center justify-center font-bold text-base sm:text-lg shrink-0 shadow-xs">
                    {style.mascot}
                  </div>
                  <div>
                    <h4 class="font-bold text-sm sm:text-base text-stone-900">{unit.name}</h4>
                    <span class="text-[11px] sm:text-xs font-semibold text-amber-800 uppercase tracking-wider block">{unit.target}</span>
                    <p class="text-xs text-stone-600 mt-1 leading-relaxed">{unit.role}</p>
                  </div>
                </div>
              ))}
            </div>

            <!-- 3 Adventure Highlights Cards (WOW Factor) -->
            <div class="space-y-3 sm:space-y-4">
              <div class="flex items-center gap-2 text-xs font-black uppercase tracking-wider text-stone-500">
                <Sparkles class="w-4 h-4 text-gold-500" />
                <span><T en="What Youth Love About This Branch" ar="أبرز ما يعيشه ويبنيه الشباب في هذا الفرع" /></span>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-5">
                {style.highlights.map(h => (
                  <div class="p-3.5 sm:p-5 rounded-xl sm:rounded-2xl bg-stone-50 border border-stone-200 hover:border-stone-400 transition-colors flex flex-col justify-between">
                    <div>
                      <span class="text-xl sm:text-2xl block mb-1.5 sm:mb-2">{h.icon}</span>
                      <h4 class="font-bold text-sm sm:text-base text-stone-900">
                        <T en={h.title} ar={h.titleAr} />
                      </h4>
                      <p class="text-xs text-stone-600 leading-relaxed mt-1">
                        {h.desc}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Deep Dive: Parent Trust vs Youth Skills Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 pt-3 sm:pt-4 border-t border-stone-100">
              
              <!-- For Parents: Peace of mind, safety, values -->
              <div class="rounded-xl sm:rounded-2xl p-4 sm:p-6 bg-emerald-50/60 border border-emerald-200/80 space-y-3 sm:space-y-4">
                <div class="flex items-center gap-2.5 text-emerald-950 font-bold text-sm sm:text-base">
                  <Shield class="w-5 h-5 text-emerald-700 shrink-0" />
                  <h4>
                    <T en="Why Parents in Byblos Value This Branch" ar="لماذا يثق الأهل بهذا الفرع الكشفي" />
                  </h4>
                </div>
                <ul class="lang-en space-y-2 text-xs sm:text-sm text-stone-700">
                  {section.parentHighlights.map(item => (
                    <li class="flex items-start gap-2">
                      <span class="text-emerald-700 font-bold shrink-0 mt-0.5">✓</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
                <ul class="lang-ar space-y-2 text-xs sm:text-sm text-stone-700">
                  {section.arabicParentHighlights.map(item => (
                    <li class="flex items-start gap-2">
                      <span class="text-emerald-700 font-bold shrink-0 mt-0.5">✓</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- For Teens / Scouts: Concrete skills & traditions -->
              <div class="rounded-xl sm:rounded-2xl p-4 sm:p-6 bg-amber-50/60 border border-amber-200/80 space-y-3 sm:space-y-4">
                <div class="flex items-center gap-2.5 text-amber-950 font-bold text-sm sm:text-base">
                  <Flame class="w-5 h-5 text-amber-700 shrink-0" />
                  <h4>
                    <T en="Core Outdoor & Life Skills Mastered" ar="المهارات الميدانية والتطبيقية المكتسبة" />
                  </h4>
                </div>
                <ul class="lang-en space-y-2 text-xs sm:text-sm text-stone-700">
                  {section.activities.map(activity => (
                    <li class="flex items-start gap-2">
                      <span class="text-amber-700 font-bold shrink-0 mt-0.5">✦</span>
                      <span>{activity}</span>
                    </li>
                  ))}
                </ul>
                <ul class="lang-ar space-y-2 text-xs sm:text-sm text-stone-700">
                  {section.arabicActivities.map(activity => (
                    <li class="flex items-start gap-2">
                      <span class="text-amber-700 font-bold shrink-0 mt-0.5">✦</span>
                      <span>{activity}</span>
                    </li>
                  ))}
                </ul>
              </div>

            </div>

            <!-- Branch-Specific Friendly FAQ Section -->
            <div class="pt-4 border-t border-stone-200/90 space-y-3">
              <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-stone-600">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <span><T en="Quick Questions About This Branch" ar="أسئلة سريعة شائعة حول هذا الفرع" /></span>
              </div>

              <div class="space-y-2">
                {branchFaqs[idx]?.map(faq => (
                  <details class="group bg-white rounded-xl border border-stone-200/90 shadow-xs overflow-hidden transition-all duration-200">
                    <summary class="p-3 sm:p-4 text-xs sm:text-sm font-bold text-stone-900 cursor-pointer flex items-center justify-between gap-3 list-none select-none hover:bg-stone-50 transition-colors">
                      <span class="flex items-center gap-2">
                        <span class="text-amber-600 text-xs font-black shrink-0">?</span>
                        <T en={faq.q} ar={faq.qAr} />
                      </span>
                      <span class="text-stone-400 text-xs transition-transform duration-200 group-open:rotate-180 shrink-0">
                        ▼
                      </span>
                    </summary>
                    <div class="px-3 pb-3 sm:px-4 sm:pb-4 pt-1 text-xs sm:text-sm text-stone-600 leading-relaxed border-t border-stone-100 bg-stone-50/50">
                      <T en={faq.a} ar={faq.aAr} />
                    </div>
                  </details>
                ))}
              </div>
            </div>

            <!-- Action Bar: Direct WhatsApp Question & Visit Invitation -->
            <div class="pt-6 border-t border-stone-200 flex flex-col sm:flex-row items-center justify-between gap-4">
              <div class="text-xs text-stone-600 flex items-center gap-2">
                <MapPin class="w-4 h-4 text-cedar-800 shrink-0" />
                <span>
                  <T 
                    en="Courtyard of Saint Jean Marc, Old Byblos. No prior scouting experience needed." 
                    ar="باحة كاتدرائية مار يوحنا مرقس، جبيل القديمة. لا يشترط أي خبرة كشفية مسبقة." 
                  />
                </span>
              </div>

