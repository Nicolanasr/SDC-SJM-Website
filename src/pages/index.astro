---
import Layout from '../layouts/Layout.astro';
import MeetingBanner from '../components/MeetingBanner.astro';
import OneStepJoin from '../components/OneStepJoin.astro';
import HistoryTimeline from '../components/HistoryTimeline.astro';
import ReviewsSlider from '../components/ReviewsSlider.astro';
import AdventureCollage from '../components/AdventureCollage.astro';
import ContactForm from '../components/ContactForm.astro';
import T from '../components/T.astro';
import { siteConfig } from '../data/siteConfig';
import { sectionsData } from '../data/sections';
import { upcomingEvents } from '../data/events';
import { blogPosts } from '../data/blog';
import { faqs } from '../data/faq';
import { MapPin, Clock, Users, ArrowRight, Calendar } from 'lucide-astro';
---

<Layout title={`${siteConfig.groupName} – ${siteConfig.tagline}`}>
  
  <!-- HERO SECTION (Full Background Group Photo with Overlay) -->
  <section class="relative min-h-[520px] sm:min-h-[640px] lg:min-h-[720px] flex items-center bg-stone-900 overflow-hidden">
    
    <!-- Background Whole Group Photo -->
    <div class="absolute inset-0 z-0">
      <img 
        src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=2400&q=85" 
        alt="Scout Des Cèdres Saint Jean Marc whole group gathering" 
        class="w-full h-full object-cover object-center brightness-90"
      />
      <!-- Gradient overlay: darker where text sits on left, fading to preserve the group photo on right -->
      <div class="absolute inset-0 bg-gradient-to-r from-stone-950/95 via-stone-950/80 to-stone-950/40"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-stone-950/80 via-transparent to-stone-950/40"></div>
    </div>

    <!-- Content on top of background -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-28 w-full">
      <div class="max-w-3xl space-y-4 sm:space-y-5">
        
        <!-- Eyebrow Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-widest bg-stone-900/80 text-amber-400 border border-stone-700/80 backdrop-blur-sm">
          <T 
            en="SCOUT DES CÈDRES • GROUPE SAINT JEAN MARC • BYBLOS" 
            ar="جمعية كشافة الأرز • فوج القديس يوحنا مرقس • جبيل" 
          />
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight leading-[1.08] sm:leading-[1.05]">
          <T 
            en="Forty-nine years of Saturday afternoons, mountain camps, and showing up." 
            ar="تسعة وأربعون عاماً من لقاءات بعد ظهر السبت، ومخيمات الجبال، والالتزام الحقيقي." 
          />
        </h1>

        <!-- Subtitle -->
        <p class="text-sand-200 text-sm sm:text-xl leading-relaxed max-w-2xl font-normal pt-1">
          <T 
            en="Since May 5, 1977, we have gathered every Saturday afternoon in the courtyard of Saint Jean Marc. No screens, no pretensions—just young people learning to build with their hands, hike the valleys of Lebanon, and look out for each other." 
            ar="منذ ٥ أيار ١٩٧٧، نلتقي كل بعد ظهر سبت في باحة مار يوحنا مرقس. بعيداً عن الشاشات والاصطناع—شباب وشابات يبنون بأيديهم، يستكشفون وديان لبنان، ويكبرون بروح الأخوّة والمسؤولية." 
          />
        </p>

        <!-- Actions -->
        <div class="pt-2 sm:pt-3 flex flex-col sm:flex-row gap-3 sm:gap-4 items-stretch sm:items-center">
          <a href="/#meeting" class="btn-scout-gold text-xs sm:text-sm shadow-lg text-center justify-center">
            <T en="Join This Saturday (3:00 – 4:30 PM)" ar="شاركنا هذا السبت (٣:٠٠ – ٤:٣٠ بعد الظهر)" />
          </a>

          <a 
            href={`https://wa.me/${siteConfig.contact.phoneRaw}?text=${encodeURIComponent(siteConfig.contact.whatsappMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-full font-bold text-xs sm:text-sm bg-white/10 hover:bg-white/20 text-white border border-white/25 backdrop-blur-sm transition-all text-center"
          >
            <svg class="w-4 h-4 fill-emerald-400 shrink-0" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.54 2.112.822 3.19.822 3.181 0 5.767-2.587 5.768-5.766.001-3.182-2.585-5.768-5.768-5.768zm0-2c4.284 0 7.768 3.484 7.768 7.768 0 4.283-3.484 7.767-7.768 7.768-1.328 0-2.585-.341-3.69-.941l-4.341 1.139 1.159-4.238c-.684-1.161-1.096-2.502-1.096-3.727 0-4.284 3.484-7.768 7.768-7.768z"/>
            </svg>
            <T en="Message on WhatsApp" ar="راسلنا عبر واتساب" />
          </a>
        </div>

      </div>
    </div>

  </section>

  <!-- WHEN, WHERE & HOW TO JOIN (Unified non-repetitive section with embedded Google Map) -->
  <section id="meeting" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <MeetingBanner />
  </section>

  <!-- HISTORY SECTION (Exact replica of screenshot timeline) -->
  <HistoryTimeline />

  <!-- SECTIONS / UNITS (With Photos for Each Age Section) -->
  <section class="py-12 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 sm:gap-6 mb-8 sm:mb-12">
      <div>
        <span class="text-xs uppercase tracking-widest font-bold text-stone-500 block font-sans">
          <T en="OUR THREE BRANCHES" ar="فروع الفوج الكشفي" />
        </span>
        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black text-stone-900 tracking-tight mt-1">
          <T en="A section for every age." ar="قسم مخصص لكل فئة عمرية." />
        </h2>
        <p class="text-stone-600 text-sm sm:text-base mt-1.5 max-w-xl">
          <T 
            en="From four-year-old cubs exploring the forest to twenty-four-year-old rovers leading community service in Byblos." 
            ar="من الصغار بعمر ٤ سنوات يستكشفون الغابة إلى الجوالة بعمر ٢٤ سنة في خدمة مجتمع بيبلوس ووديانها."
          />
        </p>
      </div>

      <a href="/sections" class="btn-scout-outline text-xs uppercase tracking-wider self-start md:self-auto">
        <T en="View Full Section Guide →" ar="دليل الأقسام الكامل ←" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-8">
      {sectionsData.map(section => (
        <div class="bg-white rounded-3xl p-4 sm:p-6 border border-stone-200 shadow-sm flex flex-col justify-between hover:border-stone-400 transition-colors">
          <div class="space-y-4">
            
            <!-- Section Image -->
            <div class="aspect-[16/10] w-full rounded-2xl overflow-hidden bg-stone-200 relative">
              <img 
                src={section.image} 
                alt={section.name} 
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                loading="lazy"
              />
              <span class={`absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white/95 text-stone-900 shadow-sm backdrop-blur-sm border border-stone-200`}>
                <T en={section.ageRange} ar={section.arabicAgeRange} />
              </span>
            </div>

            <div class="pt-1">
              <h3 class="text-2xl font-black text-stone-900 tracking-tight">
                <T en={section.name} ar={section.arabicName} />
              </h3>
              <p class="text-xs text-stone-500 italic mt-0.5">
                <T en={section.frenchName} ar={section.motto} />
              </p>
            </div>

            <p class="text-sm text-stone-600 leading-relaxed">
              <T en={section.summary} ar={section.arabicSummary} />
            </p>

            <ul class="space-y-2 pt-2 border-t border-stone-100 text-xs text-stone-600">
              {section.activities.slice(0, 3).map(activity => (
                <li class="flex items-center gap-2">
                  <span class="text-cedar-800 font-bold">•</span>
                  <span>{activity}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-5 border-t border-stone-100 mt-5">
            <a 
              href={`/sections#${section.id}`} 
              class="inline-flex items-center justify-between w-full font-bold text-xs uppercase tracking-wider text-cedar-800 hover:text-cedar-950"
            >
              <span class="lang-en">Explore {section.name}</span>
              <span class="lang-ar">استكشف {section.arabicName}</span>
              <ArrowRight class="w-4 h-4 rtl:rotate-180" />
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CATCHY ZERO-PAPERWORK JOIN GUIDE -->
  <OneStepJoin />

  <!-- REVIEWS & STORIES (Exact replica of screenshot with peeked cards) -->
  <ReviewsSlider />

  <!-- THIS IS WHAT ADVENTURE LOOKS LIKE (Collage grid opening respective albums) -->
  <AdventureCollage />

  <!-- UPCOMING CAMPS & EVENTS (Authentic Scout Editorial Style) -->
  <section class="py-12 sm:py-24 bg-[#FAF7F2] border-t border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header Bar -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-12 gap-4 sm:gap-6">
        <div>
          <span class="text-xs uppercase tracking-widest font-bold text-stone-500 block font-sans">
            <T en="ANNUAL CAMPS & TRADITIONS" ar="المخيمات والتقاليد السنوية" />
          </span>
          <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black text-stone-900 tracking-tight mt-1">
            <T en="Life under canvas." ar="الحياة تحت الخيمة." />
          </h2>
        </div>

        <p class="text-stone-600 text-sm sm:text-base max-w-md">
          <T 
            en="Every season has its rhythm. Spring in Qadisha, anniversary marches through Byblos, and ten full days under canvas in the high mountains each summer." 
            ar="لكل فصل إيقاعه الكشفي. في الربيع نخيم في قاديشا، وفي أيار نحتفل بمسيرة بيبلوس، وفي تموز نقضي عشرة أيام كاملة تحت الخيمة في أعالي الجبال." 
          />
        </p>
      </div>

      <!-- 3 Authentic Scout Event Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-8">
        {upcomingEvents.slice(0, 3).map(event => (
          <div class="bg-white rounded-3xl border border-stone-200 p-4 sm:p-6 shadow-sm hover:border-stone-400 transition-all flex flex-col justify-between">
            <div class="space-y-4">
              <!-- Photo with organic date tag -->
              <div class="aspect-[16/10] w-full rounded-2xl overflow-hidden bg-stone-200 relative">
                <img 
                  src={event.image} 
                  alt={event.title} 
                  class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                  loading="lazy"
                />
                <!-- Scout Date Badge -->
                <div class="absolute top-3 left-3 bg-stone-950/85 backdrop-blur-sm text-sand-50 rounded-xl px-3 py-1.5 shadow-sm text-center border border-white/15">
                  <div class="text-[10px] font-bold uppercase tracking-wider text-gold-400">{event.date.split(',')[0]}</div>
                </div>
                <!-- Category badge -->
                <div class="absolute bottom-3 right-3">
                  <span class={`inline-block px-3 py-1 rounded-full text-xs font-bold shadow-sm ${event.badgeColor}`}>
                    {event.badge}
                  </span>
                </div>
              </div>

              <!-- Title & description -->
              <div>
                <h3 class="text-2xl font-black text-stone-900 tracking-tight leading-snug">
                  {event.title}
                </h3>
                <p class="text-xs text-stone-600 leading-relaxed mt-2 line-clamp-3">
                  {event.description}
                </p>
              </div>

              <!-- Clean, human scout metadata -->
              <div class="pt-3 border-t border-stone-100 space-y-2 text-xs text-stone-600">
                <div class="flex items-center gap-2">
                  <MapPin class="w-3.5 h-3.5 text-cedar-700 shrink-0" />
                  <span class="font-medium text-stone-800">{event.location.split('&')[0].trim()}</span>
                </div>
                <div class="flex items-center gap-2">
                  <Clock class="w-3.5 h-3.5 text-cedar-700 shrink-0" />
                  <span>{event.duration}</span>
                  <span class="text-stone-300">•</span>
                  <span>{event.ages}</span>
                </div>
              </div>
            </div>

            <!-- Single high-contrast Action Button -->
            <div class="pt-5 mt-5 border-t border-stone-100">
              <a 
                href={`/events/${event.id}`}
                class="btn-scout-gold w-full text-xs uppercase tracking-wider !py-3 flex items-center justify-center gap-2"
              >
                <T en="View Camp Details & Kit" ar="تفاصيل المخيم والعتاد" />
                <ArrowRight class="w-3.5 h-3.5 rtl:rotate-180" />
              </a>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- BLOG / FIELD NOTES SECTION -->
  <section class="py-12 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-stone-200">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 sm:gap-6 mb-8 sm:mb-12">
      <div>
        <span class="text-xs uppercase tracking-widest font-bold text-stone-500 block font-sans">
          <T en="CHRONICLES & GUIDES" ar="مقالات ودليل الأهل" />
        </span>
        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black text-stone-900 tracking-tight mt-1">
          <T en="Field Notes from the Troop" ar="دفتر يوميات الفوج" />
        </h2>
        <p class="text-stone-600 text-sm sm:text-base mt-1.5 max-w-xl">
          <T 
            en="Stories of woodcraft, parenting advice for sleepaway camps, and reflections on our 49-year heritage in Byblos." 
            ar="قصص ريادة الخلاء، نصائح للأهل حول المخيمات، وذكريات ٤٩ عاماً من التراث الكشفي في جبيل." 
          />
        </p>
      </div>

      <a href="/blog" class="btn-scout-outline text-xs uppercase tracking-wider self-start md:self-auto">
        <T en="Read All Field Notes →" ar="قراءة جميع المقالات ←" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-8">
      {blogPosts.map(post => (
        <article class="bg-white rounded-3xl border border-stone-200 overflow-hidden shadow-sm hover:shadow-md hover:border-stone-400 transition-all flex flex-col justify-between">
          <div>
            <a href={`/blog/${post.slug}`} class="block aspect-[16/10] overflow-hidden bg-stone-200">
              <img 
                src={post.image} 
                alt={post.title} 
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                loading="lazy"
              />
            </a>

            <div class="p-4 sm:p-6 space-y-2.5">
              <div class="flex items-center justify-between text-xs font-bold text-stone-500">
                <span class="px-2.5 py-0.5 rounded-full bg-stone-100 text-stone-700 uppercase tracking-wider text-[10px]">
                  {post.category}
                </span>
                <span>{post.readTime}</span>
              </div>

              <h3 class="text-lg sm:text-xl font-bold text-stone-900 tracking-tight leading-snug">
                <a href={`/blog/${post.slug}`} class="hover:text-cedar-800 transition-colors">
                  {post.title}
                </a>
              </h3>

              <p class="text-xs text-stone-600 leading-relaxed line-clamp-3">
                {post.excerpt}
              </p>
            </div>
          </div>

          <div class="px-4 pb-4 sm:px-6 sm:pb-6 pt-2 border-t border-stone-100 flex items-center justify-between text-xs text-stone-500">
            <span>{post.date}</span>
            <a href={`/blog/${post.slug}`} class="font-bold text-cedar-800 hover:text-cedar-950 uppercase tracking-wider text-[11px] underline">
              <T en="Read Article →" ar="قراءة المقال ←" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- LEADERSHIP SECTION LINK -->
  <section class="py-10 sm:py-16 bg-[#FAF7F2] border-t border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl p-5 sm:p-10 lg:p-12 border border-stone-200 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4 sm:gap-6">
        <div>
          <span class="text-xs uppercase tracking-widest font-bold text-stone-500 block font-sans">
            <T en="VOLUNTEER LEADERSHIP" ar="القيادة التطوعية" />
          </span>
          <h2 class="text-xl sm:text-3xl font-black text-stone-900 tracking-tight mt-1">
            <T en="The chefs and cheftaines behind the troop." ar="القادة والقائدات في خدمة الفوج." />
          </h2>
          <p class="text-stone-600 text-xs sm:text-sm max-w-xl mt-1 leading-relaxed">
            <T 
              en="100% volunteer-run. Meet the chefs, cheftaines, chaplain, and maitrise who dedicate their Saturday afternoons to Saint Jean Marc." 
              ar="فوج تطوعي ١٠٠٪. تعرفوا على القادة، المرشد الروحي، ومجلس الفوج الذين يكرسون سبتهم لخدمة أطفالنا في مار يوحنا مرقس." 
            />
          </p>
        </div>

        <a href="/leadership" class="btn-scout-primary text-xs uppercase tracking-wider shrink-0 w-full sm:w-auto text-center justify-center">
          <T en="Meet the Leaders →" ar="تعرف على القادة ←" />
        </a>
      </div>
    </div>
  </section>

  <!-- PARENT FAQS ACCORDION -->
  <section id="faq" class="py-12 sm:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center space-y-1.5 sm:space-y-2 mb-8 sm:mb-12">
      <span class="text-xs uppercase tracking-widest font-bold text-stone-500 font-sans block">
        <T en="FREQUENT QUESTIONS" ar="الأسئلة الشائعة" />
      </span>
      <h2 class="text-2xl sm:text-4xl font-black text-stone-900 tracking-tight">
        <T en="What parents ask us most." ar="أبرز ما يسأله الأهل." />
      </h2>
    </div>

    <!-- Sleek Accordion List matching reference style -->
    <div class="divide-y divide-stone-200 border-y border-stone-200" id="faq-accordion">
      {faqs.map((faq, idx) => (
        <div class="faq-item group">
          <button 
            type="button" 
            class="faq-toggle w-full py-4 sm:py-6 text-left flex items-center justify-between gap-4 sm:gap-6 focus:outline-none cursor-pointer"
            aria-expanded={idx === 0 ? "true" : "false"}
          >
            <span class="text-base sm:text-xl font-bold text-stone-900 group-hover:text-cedar-800 transition-colors">
              <T en={faq.question} ar={faq.questionAr} />
            </span>
            <span class="faq-icon-wrapper w-7 h-7 sm:w-8 sm:h-8 rounded-full border border-stone-300 flex items-center justify-center shrink-0 text-stone-600 group-hover:border-cedar-800 group-hover:text-cedar-800 transition-all">
              <svg class="faq-icon w-3.5 h-3.5 sm:w-4 sm:h-4 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={idx === 0 ? "M20 12H4" : "M12 4v16m8-8H4"} />
              </svg>
            </span>
          </button>

          <div class={`faq-answer overflow-hidden transition-all duration-300 pb-4 sm:pb-6 text-stone-600 text-sm sm:text-base leading-relaxed max-w-3xl ${idx === 0 ? '' : 'hidden'}`}>
            <T en={faq.answer} ar={faq.answerAr} />
          </div>
        </div>
      ))}
    </div>

    <script>
      const toggles = document.querySelectorAll('.faq-toggle');

      toggles.forEach(toggle => {
        toggle.addEventListener('click', () => {
          const item = toggle.closest('.faq-item');
          const answer = item?.querySelector('.faq-answer') as HTMLElement;
          const svgPath = toggle.querySelector('.faq-icon path');
          const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

          // Close all items
          document.querySelectorAll('.faq-answer').forEach(ans => ans.classList.add('hidden'));
          document.querySelectorAll('.faq-toggle').forEach(t => {
            t.setAttribute('aria-expanded', 'false');
            const p = t.querySelector('.faq-icon path');
            if (p) p.setAttribute('d', 'M12 4v16m8-8H4');
          });

          // Toggle clicked item
          if (!isExpanded && answer && svgPath) {
            answer.classList.remove('hidden');
            toggle.setAttribute('aria-expanded', 'true');
            svgPath.setAttribute('d', 'M20 12H4'); // minus icon
          }
        });
      });
    </script>
  </section>

  <!-- CONTACT & WHATSAPP -->
  <section id="contact" class="py-12 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-stone-200">
    <div class="text-center max-w-xl mx-auto space-y-1.5 sm:space-y-2 mb-8 sm:mb-12">
      <span class="text-xs uppercase tracking-widest font-bold text-stone-500 font-sans block">
        <T en="GET IN TOUCH" ar="تواصل معنا" />
      </span>
      <h2 class="text-2xl sm:text-4xl font-black text-stone-900 tracking-tight">
        <T en="Drop by or send a message." ar="تفضلوا بزيارتنا أو راسلونا." />
      </h2>
      <p class="text-stone-600 text-xs sm:text-sm">
        <T 
          en="We answer all questions about registration, uniforms, and joining the Saint Jean Marc family." 
          ar="نجيب على كافة استفساراتكم حول التسجيل، الزي الكشفي، والانضمام إلى عائلة مار يوحنا مرقس." 
        />
      </p>
    </div>

    <ContactForm />
  </section>

</Layout>
