---
import Layout from '../layouts/Layout.astro';
import MeetingBanner from '../components/MeetingBanner.astro';
import OneStepJoin from '../components/OneStepJoin.astro';
import ByblosMapSketch from '../components/ByblosMapSketch.astro';
import HistoryTimeline from '../components/HistoryTimeline.astro';
import ReviewsSlider from '../components/ReviewsSlider.astro';
import AdventureCollage from '../components/AdventureCollage.astro';
import ContactForm from '../components/ContactForm.astro';
import { siteConfig } from '../data/siteConfig';
import { sectionsData } from '../data/sections';
import { upcomingEvents } from '../data/events';
import { blogPosts } from '../data/blog';
import { faqs } from '../data/faq';
---

<Layout title={`${siteConfig.groupName} – ${siteConfig.tagline}`}>
  
  <!-- HERO SECTION (Full Background Group Photo with Overlay) -->
  <section class="relative min-h-[580px] sm:min-h-[640px] lg:min-h-[720px] flex items-center bg-stone-900 overflow-hidden">
    
    <!-- Background Whole Group Photo -->
    <div class="absolute inset-0 z-0">
      <img 
        src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=2400&q=85" 
        alt="Scout Des Cèdres Saint Jean Marc whole group gathering" 
        class="w-full h-full object-cover object-center brightness-90"
      />
      <!-- Gradient overlay: darker where text sits on left, fading to preserve the group photo on right -->
      <div class="absolute inset-0 bg-gradient-to-r from-stone-950/95 via-stone-950/80 to-stone-950/40"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-stone-950/80 via-transparent to-stone-950/40"></div>
    </div>

    <!-- Content on top of background -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 w-full">
      <div class="max-w-3xl space-y-5">
        
        <!-- Eyebrow Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest bg-stone-900/80 text-amber-400 border border-stone-700/80 backdrop-blur-sm">
          <span>SCOUT DES CÈDRES • GROUPE SAINT JEAN MARC • BYBLOS</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight leading-[1.05]">
          Forty-nine years of Saturday afternoons, mountain camps, and showing up.
        </h1>

        <!-- Subtitle -->
        <p class="text-sand-200 text-lg sm:text-xl leading-relaxed max-w-2xl font-normal pt-1">
          Founded May 5, 1977. We gather every Saturday near the UNESCO Se7a in Byblos, giving young people real outdoor skills, autonomous patrols, and friendships that last a lifetime.
        </p>

        <!-- Actions -->
        <div class="pt-3 flex flex-wrap gap-4 items-center">
          <a href="/#meeting" class="btn-scout-gold text-sm shadow-lg">
            Join This Saturday (3:00 – 4:30 PM)
          </a>

          <a 
            href={`https://wa.me/${siteConfig.contact.phoneRaw}?text=${encodeURIComponent(siteConfig.contact.whatsappMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-full font-bold text-sm bg-white/10 hover:bg-white/20 text-white border border-white/25 backdrop-blur-sm transition-all"
          >
            <svg class="w-4 h-4 fill-emerald-400" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.54 2.112.822 3.19.822 3.181 0 5.767-2.587 5.768-5.766.001-3.182-2.585-5.768-5.768-5.768zm0-2c4.284 0 7.768 3.484 7.768 7.768 0 4.283-3.484 7.767-7.768 7.768-1.328 0-2.585-.341-3.69-.941l-4.341 1.139 1.159-4.238c-.684-1.161-1.096-2.502-1.096-3.727 0-4.284 3.484-7.768 7.768-7.768z"/>
            </svg>
            <span>Message on WhatsApp</span>
          </a>
        </div>

      </div>
    </div>

  </section>

  <!-- MEETING BANNER & ZERO COMMITMENT 1-STEP JOIN -->
  <section id="meeting" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <MeetingBanner />

    <!-- 1-Step Join Callout -->
    <OneStepJoin />

    <!-- Byblos Walking Map Sketch (Field-Journal Style) -->
    <ByblosMapSketch />
  </section>

  <!-- HISTORY SECTION (Exact replica of screenshot timeline) -->
  <HistoryTimeline />

  <!-- SECTIONS / UNITS -->
  <section class="py-20 sm:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <span class="text-xs uppercase tracking-widest font-bold text-stone-500 block font-sans">
          OUR THREE BRANCHES
        </span>
        <h2 class="text-3xl sm:text-5xl font-black text-stone-900 tracking-tight mt-1">
          A section for every age.
        </h2>
        <p class="text-stone-600 text-sm sm:text-base mt-2 max-w-xl">
          From four-year-old cubs exploring the forest to twenty-four-year-old rovers leading community service in Byblos.
        </p>
      </div>

      <a href="/sections" class="btn-scout-outline text-xs uppercase tracking-wider">
        View Full Section Guide →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {sectionsData.map(section => (
        <div class="bg-white rounded-3xl p-8 border border-stone-200 shadow-sm flex flex-col justify-between hover:border-stone-400 transition-colors">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class={`px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider border ${section.badgeColor}`}>
                {section.ageRange}
              </span>
              <span class="text-xs font-bold text-stone-400">
                {section.arabicName}
              </span>
            </div>

            <div>
              <h3 class="text-2xl font-black text-stone-900 tracking-tight">{section.name}</h3>
              <p class="text-xs text-stone-500 italic mt-0.5">{section.frenchName}</p>
            </div>

            <p class="text-sm text-stone-600 leading-relaxed">
              {section.summary}
            </p>

            <ul class="space-y-2 pt-2 border-t border-stone-100 text-xs text-stone-600">
              {section.activities.slice(0, 3).map(activity => (
                <li class="flex items-center gap-2">
                  <span class="text-cedar-800 font-bold">•</span>
                  <span>{activity}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-6 border-t border-stone-100 mt-6">
            <a 
              href={`/sections#${section.id}`} 
              class="inline-flex items-center justify-between w-full font-bold text-xs uppercase tracking-wider text-cedar-800 hover:text-cedar-950"
            >
              <span>Learn More</span>
              <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- REVIEWS & STORIES (Exact replica of screenshot with peeked cards) -->
  <ReviewsSlider />

  <!-- THIS IS WHAT ADVENTURE LOOKS LIKE (Collage grid opening respective albums) -->
  <AdventureCollage />

  <!-- UPCOMING CAMPS & EVENTS (Light Background matching media_1792752835600.png) -->
  <section class="py-20 sm:py-28 bg-[#FAF7F2] border-t border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header matching reference -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <h2 class="text-3xl sm:text-5xl font-black text-stone-900 tracking-tight">
            Major Camps & Gatherings
          </h2>
        </div>

        <p class="text-stone-600 text-sm sm:text-base max-w-md">
          Three ways to experience outdoor scouting with Saint Jean Marc. Compare our upcoming camps and choose the right adventure for your child.
        </p>
      </div>

      <!-- 3 Cards matching media_1792752835600.png -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {upcomingEvents.slice(0, 3).map(event => (
          <div class="bg-white rounded-[2rem] border border-stone-200 p-5 sm:p-6 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <!-- Photo on top with rounded-2xl -->
              <div class="aspect-[16/10] w-full rounded-2xl overflow-hidden bg-stone-200 relative mb-5">
                <img 
                  src={event.image} 
                  alt={event.title} 
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>

              <!-- Pill Tag -->
              <span class={`inline-block px-3 py-1 rounded-full text-xs font-bold ${event.badgeColor}`}>
                {event.badge}
              </span>

              <!-- Title & description -->
              <h3 class="text-2xl font-black text-stone-900 tracking-tight mt-2.5">
                {event.title}
              </h3>

              <p class="text-xs text-stone-600 leading-relaxed mt-2 line-clamp-3">
                {event.description}
              </p>

              <!-- 2x2 Specs Grid with subtle icons -->
              <div class="grid grid-cols-2 gap-3.5 pt-5 mt-5 border-t border-stone-100 text-xs">
                <div>
                  <div class="flex items-center gap-1.5 text-stone-400 font-medium">
                    <svg class="w-3.5 h-3.5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span>Location</span>
                  </div>
                  <div class="font-bold text-stone-800 mt-0.5">{event.location.split('&')[0].trim()}</div>
                </div>

                <div>
                  <div class="flex items-center gap-1.5 text-stone-400 font-medium">
                    <svg class="w-3.5 h-3.5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>Duration</span>
                  </div>
                  <div class="font-bold text-stone-800 mt-0.5">{event.duration}</div>
                </div>

                <div>
                  <div class="flex items-center gap-1.5 text-stone-400 font-medium">
                    <svg class="w-3.5 h-3.5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    <span>Dates</span>
                  </div>
                  <div class="font-bold text-stone-800 mt-0.5">{event.date.split(',')[0]}</div>
                </div>

                <div>
                  <div class="flex items-center gap-1.5 text-stone-400 font-medium">
                    <svg class="w-3.5 h-3.5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <span>Ages</span>
                  </div>
                  <div class="font-bold text-stone-800 mt-0.5">{event.ages}</div>
                </div>
              </div>
            </div>

            <!-- Action Buttons matching screenshot -->
            <div class="pt-6 mt-6 border-t border-stone-100 flex items-center justify-between gap-3">
              <a 
                href={`/events/${event.id}`}
                class="btn-scout-gold text-xs !py-2.5 !px-5"
              >
                Event Details & Portal
              </a>

              <a 
                href={`/events/${event.id}`} 
                class="text-xs font-bold text-stone-700 hover:text-stone-950 underline"
              >
                Schedule →
              </a>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- BLOG / FIELD NOTES SECTION -->
  <section class="py-20 sm:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-stone-200">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <span class="text-xs uppercase tracking-widest font-bold text-stone-500 block font-sans">
          CHRONICLES & GUIDES
        </span>
        <h2 class="text-3xl sm:text-5xl font-black text-stone-900 tracking-tight mt-1">
          Field Notes from the Troop
        </h2>
        <p class="text-stone-600 text-sm sm:text-base mt-2 max-w-xl">
          Stories of woodcraft, parenting advice for sleepaway camps, and reflections on our 49-year heritage in Byblos.
        </p>
      </div>

      <a href="/blog" class="btn-scout-outline text-xs uppercase tracking-wider">
        Read All Field Notes →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {blogPosts.map(post => (
        <article class="bg-white rounded-3xl border border-stone-200 overflow-hidden shadow-sm hover:shadow-md hover:border-stone-400 transition-all flex flex-col justify-between">
          <div>
            <a href={`/blog/${post.slug}`} class="block aspect-[16/10] overflow-hidden bg-stone-200">
              <img 
                src={post.image} 
                alt={post.title} 
                class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                loading="lazy"
              />
            </a>

            <div class="p-6 space-y-2.5">
              <div class="flex items-center justify-between text-xs font-bold text-stone-500">
                <span class="px-2.5 py-0.5 rounded-full bg-stone-100 text-stone-700 uppercase tracking-wider text-[10px]">
                  {post.category}
                </span>
                <span>{post.readTime}</span>
              </div>

              <h3 class="text-xl font-bold text-stone-900 tracking-tight leading-snug">
                <a href={`/blog/${post.slug}`} class="hover:text-cedar-800 transition-colors">
                  {post.title}
                </a>
              </h3>

              <p class="text-xs text-stone-600 leading-relaxed line-clamp-3">
                {post.excerpt}
              </p>
            </div>
          </div>

          <div class="px-6 pb-6 pt-2 border-t border-stone-100 flex items-center justify-between text-xs text-stone-500">
            <span>{post.date}</span>
            <a href={`/blog/${post.slug}`} class="font-bold text-cedar-800 hover:text-cedar-950 uppercase tracking-wider text-[11px] underline">
              Read Article →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- LEADERSHIP SECTION LINK -->
  <section class="py-16 bg-[#FAF7F2] border-t border-stone-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-stone-200 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-xs uppercase tracking-widest font-bold text-stone-500 block font-sans">
            VOLUNTEER COUNCIL
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-stone-900 tracking-tight mt-1">
            Scout Leadership Hierarchy Tree
          </h2>
          <p class="text-stone-600 text-sm max-w-xl mt-1">
            Inspect the visual organizational chart of our Chef de Groupe, chaplain, council, and section leaders.
          </p>
        </div>

        <a href="/leadership" class="btn-scout-primary text-xs uppercase tracking-wider shrink-0">
          View Hierarchy Tree →
        </a>
      </div>
    </div>
  </section>

  <!-- PARENT FAQS ACCORDION -->
  <section id="faq" class="py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center space-y-2 mb-12">
      <span class="text-xs uppercase tracking-widest font-bold text-stone-500 font-sans block">
        FREQUENT QUESTIONS
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-stone-900 tracking-tight">
        What parents ask us most.
      </h2>
    </div>

    <!-- Sleek Accordion List matching reference style -->
    <div class="divide-y divide-stone-200 border-y border-stone-200" id="faq-accordion">
      {faqs.map((faq, idx) => (
        <div class="faq-item group">
          <button 
            type="button" 
            class="faq-toggle w-full py-6 text-left flex items-center justify-between gap-6 focus:outline-none cursor-pointer"
            aria-expanded={idx === 0 ? "true" : "false"}
          >
            <span class="text-lg sm:text-xl font-bold text-stone-900 group-hover:text-cedar-800 transition-colors">
              {faq.question}
            </span>
            <span class="faq-icon-wrapper w-8 h-8 rounded-full border border-stone-300 flex items-center justify-center shrink-0 text-stone-600 group-hover:border-cedar-800 group-hover:text-cedar-800 transition-all">
              <svg class="faq-icon w-4 h-4 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={idx === 0 ? "M20 12H4" : "M12 4v16m8-8H4"} />
              </svg>
            </span>
          </button>

          <div class={`faq-answer overflow-hidden transition-all duration-300 pb-6 text-stone-600 text-sm sm:text-base leading-relaxed max-w-3xl ${idx === 0 ? '' : 'hidden'}`}>
            {faq.answer}
          </div>
        </div>
      ))}
    </div>

    <script>
      const toggles = document.querySelectorAll('.faq-toggle');

      toggles.forEach(toggle => {
        toggle.addEventListener('click', () => {
          const item = toggle.closest('.faq-item');
          const answer = item?.querySelector('.faq-answer') as HTMLElement;
          const svgPath = toggle.querySelector('.faq-icon path');
          const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

          // Close all items
          document.querySelectorAll('.faq-answer').forEach(ans => ans.classList.add('hidden'));
          document.querySelectorAll('.faq-toggle').forEach(t => {
            t.setAttribute('aria-expanded', 'false');
            const p = t.querySelector('.faq-icon path');
            if (p) p.setAttribute('d', 'M12 4v16m8-8H4');
          });

          // Toggle clicked item
          if (!isExpanded && answer && svgPath) {
            answer.classList.remove('hidden');
            toggle.setAttribute('aria-expanded', 'true');
            svgPath.setAttribute('d', 'M20 12H4'); // minus icon
          }
        });
      });
    </script>
  </section>

  <!-- CONTACT & WHATSAPP -->
  <section id="contact" class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-stone-200">
    <div class="text-center max-w-xl mx-auto space-y-2 mb-12">
      <span class="text-xs uppercase tracking-widest font-bold text-stone-500 font-sans block">
        GET IN TOUCH
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-stone-900 tracking-tight">
        Drop by or send a message.
      </h2>
      <p class="text-stone-600 text-sm">
        We answer all questions about registration, uniforms, and joining the Saint Jean Marc family.
      </p>
    </div>

    <ContactForm />
  </section>

</Layout>
