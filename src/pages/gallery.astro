---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import T from '../components/T.astro';
import { galleryPhotos } from '../data/gallery';
import { siteConfig } from '../data/siteConfig';
---

<Layout 
  title={`Photo Album & Memories – ${siteConfig.groupName} Byblos`}
  titleAr="ألبوم الصور والذكريات – كشافة الأرز جبيل"
  description="Explore moments from Scout Des Cèdres Saint Jean Marc in Byblos: mountain camps, pioneering woodcraft, hikes, and parish celebrations."
  descriptionAr="شاهدوا لقطات من أنشطة ومخيمات فوج القديس يوحنا مرقس – كشافة الأرز جبيل: مخيمات الجبال، ريادة الخلاء، ومسيرات الرعية في جبيل."
>
  <PageHeader 
    badge="PHOTO ALBUM"
    badgeAr="ألبوم الصور والميدان"
    title="Moments of Adventure"
    titleAr="سجل الذكريات والمغامرة"
    description="Photographs from our weekly Saturday meetings, high mountain camps, and parish celebrations in Byblos."
    descriptionAr="لقطات توثيقية من لقاءات السبت الأسبوعية، المخيمات الجبلية، واحتفالات الرعية في جبيل القديمة."
  />

  <!-- FILTER CHIPS -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 sm:-mt-8 mb-8 sm:mb-12">
    <div class="bg-white/95 backdrop-blur-md rounded-2xl sm:rounded-3xl p-3 sm:p-5 border border-stone-200/90 shadow-sm flex flex-wrap items-center justify-between gap-3">
      
      <div class="flex flex-wrap items-center gap-1.5 sm:gap-2" id="gallery-filters">
        <button 
          type="button" 
          data-category="all"
          class="gallery-filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold bg-cedar-800 text-white transition-all shadow-xs cursor-pointer"
        >
          <T en="All Photos" ar="جميع الصور" /> ({galleryPhotos.length})
        </button>
        <button 
          type="button" 
          data-category="summer-camps"
          class="gallery-filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold bg-stone-100 text-stone-700 hover:bg-stone-200 transition-all cursor-pointer"
        >
          <T en="⛺ Camps" ar="⛺ المخيمات" />
        </button>
        <button 
          type="button" 
          data-category="pioneering"
          class="gallery-filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold bg-stone-100 text-stone-700 hover:bg-stone-200 transition-all cursor-pointer"
        >
          <T en="🪵 Woodcraft" ar="🪵 ريادة الخلاء" />
        </button>
        <button 
          type="button" 
          data-category="hikes-expeditions"
          class="gallery-filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold bg-stone-100 text-stone-700 hover:bg-stone-200 transition-all cursor-pointer"
        >
          <T en="🧭 Hikes" ar="🧭 رحلات الجبال" />
        </button>
        <button 
          type="button" 
          data-category="parish-ceremonies"
          class="gallery-filter-btn px-3.5 py-1.5 rounded-full text-xs font-bold bg-stone-100 text-stone-700 hover:bg-stone-200 transition-all cursor-pointer"
        >
          <T en="⛪ Parish" ar="⛪ مناسبات الرعية" />
        </button>
      </div>

      <span id="gallery-count" class="text-xs font-mono font-semibold text-stone-500 hidden sm:inline">
        {galleryPhotos.length} <T en="memories" ar="صورة" />
      </span>
    </div>
  </section>

  <!-- PHOTOS GRID -->
  <section class="py-4 sm:py-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="photos-grid">
      {galleryPhotos.map((photo, index) => (
        <div 
          class="photo-card group cursor-pointer relative overflow-hidden rounded-3xl bg-white border border-stone-200 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
          data-album={photo.albumId}
          data-full-img={photo.imageUrl}
          data-title={photo.title}
          data-title-ar={photo.titleAr}
          data-location={photo.location}
          data-location-ar={photo.locationAr}
          data-year={photo.year}
          data-index={index}
        >
          <div class="aspect-[4/3] w-full overflow-hidden bg-stone-100 flex items-center justify-center">
            {photo.imageUrl ? (
              <img 
                src={photo.imageUrl} 
                alt={photo.title} 
                loading="lazy" 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            ) : (
              <div class="w-full h-full bg-stone-100 flex flex-col items-center justify-center p-4 text-center">
                <span class="text-[9px] font-bold uppercase tracking-wider text-amber-800 bg-amber-100 px-2.5 py-0.5 rounded-full mb-1">
                  Photo Needed
                </span>
                <p class="text-xs font-bold text-stone-800 line-clamp-2">
                  <T en={photo.title} ar={photo.titleAr} />
                </p>
                <p class="text-[10px] text-stone-500 mt-0.5">
                  <T en={photo.location} ar={photo.locationAr} /> • {photo.year}
                </p>
              </div>
            )}
          </div>

          <div class="p-4 bg-white flex items-center justify-between border-t border-stone-100">
            <div>
              <h3 class="font-bold text-sm text-stone-900 group-hover:text-cedar-800 transition-colors">
                <T en={photo.title} ar={photo.titleAr} />
              </h3>
              <p class="text-xs text-stone-500 mt-0.5">
                <T en={photo.location} ar={photo.locationAr} /> • <span class="font-medium text-amber-700">{photo.year}</span>
              </p>
            </div>
            
            <div class="w-8 h-8 rounded-full bg-stone-100 group-hover:bg-cedar-800 group-hover:text-white transition-colors flex items-center justify-center shrink-0 text-stone-500">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
              </svg>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Notice -->
    <div class="mt-16 text-center pt-8 border-t border-stone-200 space-y-3">
      <h3 class="text-lg font-bold text-stone-800">
        <T en="Want to live these adventures with us?" ar="هل ترغب في خوض هذه المغامرات معنا؟" />
      </h3>
      <p class="text-xs sm:text-sm text-stone-500 max-w-lg mx-auto">
        <T 
          en="Join us any Saturday afternoon between 3:00 and 4:30 PM at the Saint Jean Marc courtyard in Byblos." 
          ar="شاركونا في أي بعد ظهر سبت بين ٣:٠٠ و ٤:٣٠ في باحة مار يوحنا مرقس في جبيل القديمة." 
        />
      </p>
      <div class="pt-2">
        <a href="/#meeting" class="btn-scout-primary text-xs uppercase tracking-wider inline-block">
          <T en="Visit This Saturday" ar="تفضل بزيارتنا هذا السبت" />
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Lightbox Modal -->
  <div 
    id="lightbox-modal" 
    class="fixed inset-0 z-50 bg-stone-950/95 backdrop-blur-md hidden flex items-center justify-center p-4"
  >
    <div class="relative max-w-5xl w-full flex flex-col items-center">
      <button 
        id="lightbox-close" 
        type="button" 
        class="absolute -top-12 right-0 text-stone-400 hover:text-white text-3xl font-bold p-2 cursor-pointer focus:outline-none"
        aria-label="Close image preview"
      >
        ✕
      </button>

      <div class="w-full max-h-[75vh] flex items-center justify-center overflow-hidden rounded-2xl shadow-2xl border border-stone-800 bg-stone-950">
        <img 
          id="lightbox-img" 
          src="" 
          alt="" 
          class="max-h-[75vh] w-auto max-w-full object-contain"
        />
        <div id="lightbox-placeholder" class="hidden p-12 text-center text-white">
          <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-600 mb-2">Photo Needed</span>
          <p id="lightbox-ph-title" class="text-lg font-bold"></p>
        </div>
      </div>

      <div class="w-full max-w-2xl text-center mt-4 space-y-1">
        <h4 id="lightbox-title" class="text-white text-base sm:text-xl font-bold"></h4>
        <p id="lightbox-subtitle" class="text-stone-400 text-xs sm:text-sm"></p>
      </div>

      <!-- Navigation Arrows -->
      <div class="flex items-center gap-4 mt-4">
        <button 
          id="lightbox-prev" 
          type="button" 
          class="px-4 py-2 rounded-full bg-stone-900 border border-stone-700 text-white hover:bg-stone-800 text-xs uppercase tracking-wider font-bold cursor-pointer"
        >
          <T en="← Previous" ar="← السابق" />
        </button>
        <button 
          id="lightbox-next" 
          type="button" 
          class="px-4 py-2 rounded-full bg-stone-900 border border-stone-700 text-white hover:bg-stone-800 text-xs uppercase tracking-wider font-bold cursor-pointer"
        >
          <T en="Next →" ar="التالي ←" />
        </button>
      </div>
    </div>
  </div>

  <script>
    // Category Filtering
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.gallery-filter-btn');
    const photoCards = document.querySelectorAll<HTMLElement>('.photo-card');
    const countDisplay = document.getElementById('gallery-count');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.category || 'all';

        filterButtons.forEach(b => {
          b.classList.remove('bg-cedar-800', 'text-white');
          b.classList.add('bg-stone-100', 'text-stone-700');
        });
        btn.classList.remove('bg-stone-100', 'text-stone-700');
        btn.classList.add('bg-cedar-800', 'text-white');

        let visible = 0;
        photoCards.forEach(card => {
          if (cat === 'all' || card.dataset.album === cat) {
            card.classList.remove('hidden');
            visible++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (countDisplay) {
          countDisplay.textContent = `${visible} memories`;
        }
      });
    });

    // Lightbox Functionality
    const modal = document.getElementById('lightbox-modal');
    const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const modalPlaceholder = document.getElementById('lightbox-placeholder');
    const modalPhTitle = document.getElementById('lightbox-ph-title');
    const modalTitle = document.getElementById('lightbox-title');
    const modalSubtitle = document.getElementById('lightbox-subtitle');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');

    let currentIdx = 0;
    const items = Array.from(photoCards);

    function showPhoto(idx: number) {
      if (idx < 0) idx = items.length - 1;
      if (idx >= items.length) idx = 0;
      currentIdx = idx;

      const item = items[currentIdx];
      const imgUrl = item.dataset.fullImg || '';
      const isArabic = document.documentElement.lang === 'ar';
      const title = (isArabic ? item.dataset.titleAr : item.dataset.title) || item.dataset.title || '';
      const location = (isArabic ? item.dataset.locationAr : item.dataset.location) || item.dataset.location || '';
      const year = item.dataset.year || '';

      if (imgUrl) {
        modalImg.src = imgUrl;
        modalImg.alt = title;
        modalImg.classList.remove('hidden');
        modalPlaceholder?.classList.add('hidden');
      } else {
        modalImg.classList.add('hidden');
        modalPlaceholder?.classList.remove('hidden');
        if (modalPhTitle) modalPhTitle.textContent = title;
      }

      if (modalTitle) modalTitle.textContent = title;
      if (modalSubtitle) modalSubtitle.textContent = `${location} • ${year}`;
    }

    photoCards.forEach((item, idx) => {
      item.addEventListener('click', () => {
        showPhoto(idx);
        modal?.classList.remove('hidden');
      });
    });

    closeBtn?.addEventListener('click', () => modal?.classList.add('hidden'));
    prevBtn?.addEventListener('click', () => showPhoto(currentIdx - 1));
    nextBtn?.addEventListener('click', () => showPhoto(currentIdx + 1));

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.classList.add('hidden');
    });

    document.addEventListener('keydown', (e) => {
      if (modal?.classList.contains('hidden')) return;
      if (e.key === 'Escape') modal.classList.add('hidden');
      if (e.key === 'ArrowLeft') showPhoto(currentIdx - 1);
      if (e.key === 'ArrowRight') showPhoto(currentIdx + 1);
    });
  </script>
</Layout>
