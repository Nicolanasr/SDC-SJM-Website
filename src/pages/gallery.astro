---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import T from '../components/T.astro';
import { galleryAlbums } from '../data/gallery';
import { siteConfig } from '../data/siteConfig';
import { ArrowRight } from 'lucide-astro';
---

<Layout 
  title={`Photo Albums & Archives – ${siteConfig.groupName}`}
  description="Browse curated photo albums from Scout Des Cèdres Saint Jean Marc: Grand Camps, pioneering woodcraft, mountain hikes, and parish celebrations in Byblos."
>
  <PageHeader 
    badge="PHOTO ARCHIVES"
    badgeAr="أرشيف الصور والذكريات"
    title="Curated Scout Albums"
    titleAr="ألبومات وذكريات الفوج"
    description="Explore our photo collections from the mountains of Lebanon and the historic streets of Byblos. Click on any album to view the full photo gallery."
    descriptionAr="تصفحوا مجموعات صور الفوج من جبال لبنان وشوارع جبيل القديمة. اضغطوا على أي ألبوم للاطلاع على الصور بالكامل."
  />

  <!-- ALBUMS GRID (ALBUM VIEW FIRST) -->
  <section class="py-8 sm:py-20 max-w-7xl mx-auto px-2.5 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-10">
      {galleryAlbums.map(album => (
        <a 
          href={`/gallery/${album.id}`}
          class="album-card group rounded-2xl sm:rounded-3xl overflow-hidden bg-white border border-stone-200 shadow-sm hover:shadow-xl hover:border-emerald-700 transition-all duration-300 flex flex-col justify-between"
        >
          <!-- Cover Image with photo count badge -->
          <div class="aspect-[16/10] w-full overflow-hidden bg-stone-900 relative">
            <img 
              src={album.coverImage} 
              alt={album.name} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-95"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-stone-950/70 via-transparent to-transparent"></div>
            
            <div class="absolute bottom-3.5 right-3.5 rtl:right-auto rtl:left-3.5 bg-stone-900/85 backdrop-blur-sm text-sand-50 text-xs font-bold px-3 py-1.5 rounded-full border border-white/20 shadow-sm">
              <T en={`${album.count} Photographs`} ar={`${album.count} صور`} />
            </div>
          </div>

          <!-- Album Meta & Descriptions -->
          <div class="p-4 sm:p-8 space-y-3">
            <h2 class="text-xl sm:text-2xl font-black text-stone-900 group-hover:text-emerald-800 transition-colors tracking-tight leading-snug">
              <T en={album.name} ar={album.nameAr} />
            </h2>

            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              <T en={album.description} ar={album.descriptionAr} />
            </p>

            <div class="pt-4 border-t border-stone-100 flex items-center justify-between text-xs font-bold uppercase tracking-wider text-emerald-800 group-hover:text-emerald-950">
              <span>
                <T en="Open Album" ar="فتح الألبوم" />
              </span>
              <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform rtl:rotate-180" />
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom Notice -->
    <div class="mt-16 text-center pt-8 border-t border-stone-200 space-y-3">
      <h3 class="text-lg font-bold text-stone-800">
        <T en="Want to live these adventures with us?" ar="هل ترغب في خوض هذه المغامرات معنا؟" />
      </h3>
      <p class="text-xs sm:text-sm text-stone-500 max-w-lg mx-auto">
        <T 
          en="Join us any Saturday afternoon between 3:00 and 4:30 PM at the Saint Jean Marc courtyard in Byblos." 
          ar="شاركونا في أي بعد ظهر سبت بين ٣:٠٠ و ٤:٣٠ في باحة مار يوحنا مرقس في جبيل القديمة." 
        />
      </p>
      <div class="pt-2">
        <a href="/#meeting" class="btn-scout-primary text-xs uppercase tracking-wider inline-block">
          <T en="Visit This Saturday" ar="تفضل بزيارتنا هذا السبت" />
        </a>
      </div>
    </div>
  </section>
</Layout>
