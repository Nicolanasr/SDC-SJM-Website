---
import Layout from '../layouts/Layout.astro';
import { galleryAlbums } from '../data/gallery';
import { siteConfig } from '../data/siteConfig';
import { Search, Filter, ArrowRight } from 'lucide-astro';
---

<Layout 
  title={`Photo Albums & Archives – ${siteConfig.groupName}`}
  description="Browse curated photo albums from Scout Des Cèdres Saint Jean Marc: Grand Camps, pioneering woodcraft, mountain hikes, and parish celebrations."
>
  <!-- Header Banner -->
  <section class="bg-stone-900 text-sand-50 py-12 sm:py-20 border-b border-stone-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-3 sm:space-y-4">
      <span class="text-xs uppercase tracking-widest font-bold text-amber-400 block font-sans">
        PHOTO ARCHIVES
      </span>
      <h1 class="text-2xl sm:text-5xl font-black text-white tracking-tight">
        Curated Scout Albums
      </h1>
      <p class="text-stone-300 text-sm sm:text-lg max-w-2xl mx-auto">
        Search or filter by category to explore high-resolution camp photographs and field memories.
      </p>

      <!-- Search & Filter Controls -->
      <div class="max-w-2xl mx-auto pt-3 sm:pt-4 space-y-3 sm:space-y-4">
        <!-- Search Input with Lucide Search Icon -->
        <div class="relative">
          <Search class="w-5 h-5 text-stone-400 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" />
          <input 
            type="text" 
            id="gallery-search"
            placeholder="Search albums (e.g. camps, hiking, froissartage, Byblos)..."
            class="w-full pl-12 pr-4 py-2.5 sm:py-3 rounded-full bg-stone-800/90 border border-stone-700 text-sand-100 placeholder-stone-400 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent transition-all shadow-inner"
          />
        </div>

        <!-- Filter Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 pt-1" id="gallery-filters">
          <button 
            type="button" 
            data-filter="all" 
            class="filter-btn active px-3.5 sm:px-4 py-1.5 rounded-full text-xs font-bold transition-all bg-amber-500 text-stone-950 shadow-sm"
          >
            All Albums
          </button>
          <button 
            type="button" 
            data-filter="camps" 
            class="filter-btn px-3.5 sm:px-4 py-1.5 rounded-full text-xs font-bold transition-all bg-stone-800 text-stone-300 hover:bg-stone-700"
          >
            Camps
          </button>
          <button 
            type="button" 
            data-filter="woodcraft" 
            class="filter-btn px-3.5 sm:px-4 py-1.5 rounded-full text-xs font-bold transition-all bg-stone-800 text-stone-300 hover:bg-stone-700"
          >
            Pioneering
          </button>
          <button 
            type="button" 
            data-filter="hikes" 
            class="filter-btn px-3.5 sm:px-4 py-1.5 rounded-full text-xs font-bold transition-all bg-stone-800 text-stone-300 hover:bg-stone-700"
          >
            Hikes
          </button>
          <button 
            type="button" 
            data-filter="ceremonies" 
            class="filter-btn px-3.5 sm:px-4 py-1.5 rounded-full text-xs font-bold transition-all bg-stone-800 text-stone-300 hover:bg-stone-700"
          >
            Ceremonies
          </button>
        </div>
      </div>

    </div>
  </section>

  <!-- Albums Grid Section -->
  <section class="py-10 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-8" id="albums-grid">
      {galleryAlbums.map(album => (
        <a 
          href={`/gallery/${album.id}`}
          class="album-card group rounded-3xl overflow-hidden bg-white border border-stone-200 shadow-sm hover:shadow-md hover:border-stone-400 transition-all flex flex-col justify-between"
          data-category={album.category}
          data-name={album.name.toLowerCase()}
          data-desc={album.description.toLowerCase()}
        >
          <!-- Cover Image with photo count badge -->
          <div class="aspect-[16/9] w-full overflow-hidden bg-stone-200 relative">
            <img 
              src={album.coverImage} 
              alt={album.name} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute bottom-3 right-3 bg-stone-900/80 backdrop-blur-sm text-white text-xs font-bold px-3 py-1.5 rounded-full">
              {album.count} Photographs
            </div>
          </div>

          <!-- Album Meta -->
          <div class="p-4 sm:p-7 space-y-2.5 sm:space-y-3">
            <div class="flex items-center justify-between">
              <h2 class="text-xl sm:text-2xl font-black text-stone-900 group-hover:text-cedar-800 transition-colors tracking-tight">
                {album.name}
              </h2>
            </div>

            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
              {album.description}
            </p>

            <div class="pt-3 sm:pt-4 border-t border-stone-100 flex items-center justify-between text-xs font-bold uppercase tracking-wider text-cedar-800 group-hover:text-cedar-950">
              <span>Open Album</span>
              <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Empty state if no albums match search/filter -->
    <div id="no-albums" class="hidden text-center py-16 space-y-3">
      <div class="w-12 h-12 rounded-full bg-stone-200 flex items-center justify-center mx-auto text-stone-500">
        <Search class="w-6 h-6" />
      </div>
      <h3 class="text-lg font-bold text-stone-800">No albums found</h3>
      <p class="text-xs text-stone-500 max-w-sm mx-auto">
        Try typing a different search keyword or switch back to "All Albums".
      </p>
    </div>

    <!-- Client Script for Live Search & Category Filtering -->
    <script>
      const searchInput = document.getElementById('gallery-search') as HTMLInputElement;
      const filterBtns = document.querySelectorAll('.filter-btn');
      const albumCards = document.querySelectorAll('.album-card') as NodeListOf<HTMLElement>;
      const noAlbums = document.getElementById('no-albums');

      let currentCategory = 'all';
      let searchQuery = '';

      function applyFilter() {
        let visibleCount = 0;

        albumCards.forEach(card => {
          const category = card.getAttribute('data-category') || '';
          const name = card.getAttribute('data-name') || '';
          const desc = card.getAttribute('data-desc') || '';

          const matchesCategory = currentCategory === 'all' || category === currentCategory;
          const matchesSearch = searchQuery === '' || name.includes(searchQuery) || desc.includes(searchQuery);

          if (matchesCategory && matchesSearch) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (noAlbums) {
          if (visibleCount === 0) {
            noAlbums.classList.remove('hidden');
          } else {
            noAlbums.classList.add('hidden');
          }
        }
      }

      searchInput?.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        applyFilter();
      });

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => {
            b.classList.remove('bg-amber-500', 'text-stone-950', 'active');
            b.classList.add('bg-stone-800', 'text-stone-300');
          });

          btn.classList.add('bg-amber-500', 'text-stone-950', 'active');
          btn.classList.remove('bg-stone-800', 'text-stone-300');

          currentCategory = btn.getAttribute('data-filter') || 'all';
          applyFilter();
        });
      });
    </script>
  </section>

  <!-- Photo Contribution Note -->
  <section class="pb-24 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
    <h3 class="text-2xl font-black text-stone-900 tracking-tight">
      Have old scout photos from Saint Jean Marc?
    </h3>
    <p class="text-sm text-stone-600 max-w-md mx-auto">
      Alumni and parents with photographs from past camps (from 1977 to today) can send them directly to our media team.
    </p>
    <a 
      href={`https://wa.me/${siteConfig.contact.phoneRaw}?text=${encodeURIComponent('Hello! I have scout photos from Saint Jean Marc camps that I would like to contribute.')}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-scout-primary text-xs uppercase tracking-wider inline-block"
    >
      Send Photos on WhatsApp
    </a>
  </section>
</Layout>
