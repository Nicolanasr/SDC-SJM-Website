---
import { siteConfig } from '../data/siteConfig';
import T from './T.astro';
---

<div 
  id="troop-calendar-root" 
  data-phone={siteConfig.contact.phoneRaw} 
  class="rounded-2xl sm:rounded-3xl bg-white border border-stone-200 p-3 sm:p-8 lg:p-10 shadow-sm mb-8 sm:mb-16"
>
  
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4 pb-5 sm:pb-6 border-b border-stone-200">
    <div>
      <span class="text-xs uppercase tracking-widest font-bold text-amber-700 block font-sans">
        <T en="REGULAR WEEKLY GATHERINGS" ar="اللقاءات الأسبوعية المنتظمة" />
      </span>
      <h2 class="text-xl sm:text-3xl font-black text-stone-900 tracking-tight">
        <T en="Troop Saturday Calendar" ar="رزنامة لقاءات السبت" />
      </h2>
    </div>

    <!-- Month Switcher Controls -->
    <div class="flex items-center gap-2 self-start sm:self-auto">
      <button 
        type="button" 
        id="cal-prev-btn" 
        class="w-8 h-8 sm:w-9 sm:h-9 rounded-full border border-stone-300 hover:bg-stone-100 flex items-center justify-center text-stone-700 transition-colors cursor-pointer"
        aria-label="Previous Month"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <span id="cal-month-title" class="font-bold text-xs sm:text-sm text-stone-900 px-2 sm:px-3 min-w-[100px] sm:min-w-[120px] text-center font-sans">
        May 2026
      </span>

      <button 
        type="button" 
        id="cal-next-btn" 
        class="w-8 h-8 sm:w-9 sm:h-9 rounded-full border border-stone-300 hover:bg-stone-100 flex items-center justify-center text-stone-700 transition-colors cursor-pointer"
        aria-label="Next Month"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 pt-6 sm:pt-8 items-start">
    
    <!-- LEFT: Calendar Widget -->
    <div class="lg:col-span-5 bg-[#FAF7F2] rounded-xl sm:rounded-3xl p-2.5 sm:p-5 border border-stone-300/80 shadow-sm">
      
      <!-- Day Names Header Row -->
      <div class="grid grid-cols-7 gap-1 text-center font-bold text-[11px] text-stone-500 uppercase tracking-wider mb-2">
        <span>Su</span>
        <span>Mo</span>
        <span>Tu</span>
        <span>We</span>
        <span>Th</span>
        <span>Fr</span>
        <span class="text-emerald-800 font-extrabold">Sa</span>
      </div>

      <!-- Days Grid (Populated dynamically by JavaScript) -->
      <div id="calendar-days-grid" class="grid grid-cols-7 gap-1 text-center text-xs font-semibold">
        <!-- Rendered by JS -->
      </div>

      <!-- Calendar Legend -->
      <div class="mt-6 pt-4 border-t border-stone-300/80 space-y-2 text-[11px] text-stone-600">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
          <span>
            <T en="Every Saturday: Weekly Meeting (3:00 PM – 4:30 PM)" ar="كل سبت: لقاء أسبوعي (٣:٠٠ – ٤:٣٠ بعد الظهر)" />
          </span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-600"></span>
          <span>
            <T en="Saint Jean Marc Courtyard in Byblos" ar="باحة مار يوحنا مرقس في جبيل القديمة" />
          </span>
        </div>
      </div>

    </div>

    <!-- RIGHT: Active Selected Saturday Details Card (Server Pre-rendered for zero empty state) -->
    <div class="lg:col-span-7 space-y-3 sm:space-y-4">
      
      <div class="text-xs uppercase tracking-widest font-bold text-stone-500">
        <T en="Schedule for Selected Saturday:" ar="برنامج نشاط يوم السبت المحدد:" />
      </div>

      <div id="event-spotlight-card" class="bg-white rounded-xl sm:rounded-3xl border border-stone-300 p-3.5 sm:p-7 shadow-sm space-y-3.5 sm:space-y-4 transition-all">
        <div class="flex items-center justify-between">
          <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-emerald-700 text-white">
            <T en="Weekly Gathering" ar="لقاء أسبوعي منتظم" />
          </span>
          <span class="text-xs font-bold text-stone-600 bg-stone-100 px-2.5 py-0.5 rounded-full border border-stone-200">
            <T en="Every Saturday • 3:00 PM – 4:30 PM" ar="كل سبت • ٣:٠٠ – ٤:٣٠ بعد الظهر" />
          </span>
        </div>

        <div>
          <h3 class="text-2xl font-black text-stone-900 tracking-tight leading-snug">
            <T en="Saturday Scout Gathering" ar="اللقاء الكشفي الأسبوعي" />
          </h3>
          <p class="text-xs font-semibold text-emerald-800 mt-1">
            <T en="3:00 PM – 4:30 PM • Saint Jean Marc Courtyard, Byblos" ar="٣:٠٠ – ٤:٣٠ بعد الظهر • باحة مار يوحنا مرقس، جبيل" />
          </p>
        </div>

        <p class="text-stone-600 text-sm leading-relaxed">
          <T 
            en="Weekly gathering for all three branches: Louveteaux & Jeannettes (جراميز وزهرات, ages 4–11), Scouts & Guides (كشافة ومرشدات, ages 11–16), and Routiers & Caravelles (جوالة ومنجدات, ages 16–24). Outdoor games, woodcraft skills, character growth, and team spirit." 
            ar="اللقاء الأسبوعي لجميع الفروع الكشفية: جراميز وزهرات (٤–١١ سنة)، كشافة ومرشدات (١١–١٦ سنة)، وجوالة ومنجدات (١٦–٢٤ سنة). ألعاب هادفة، مهارات كشفية، وبناء الشخصية." 
          />
        </p>

        <div class="pt-4 border-t border-stone-200 flex flex-col sm:flex-row items-center justify-between gap-3">
          <a 
            href="/events/weekly-saturday-meeting" 
            class="btn-scout-gold text-xs !py-2.5 !px-5 w-full sm:w-auto text-center font-bold"
          >
            <T en="View Full Routine & Kit Checklist →" ar="تفاصيل اللقاء وما يحتاجه الكشاف ←" />
          </a>
          <a 
            href={`https://wa.me/${siteConfig.contact.phoneRaw}?text=${encodeURIComponent('Hello! I would like to attend the Saturday scout meeting at Saint Jean Marc Byblos.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-bold text-emerald-800 hover:text-emerald-950 underline"
          >
            <T en="Ask on WhatsApp" ar="راسلنا عبر واتساب" />
          </a>
        </div>
      </div>

      <div class="pt-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs text-stone-500">
        <span>
          <T en="Click any highlighted Saturday in the calendar to check timing." ar="اضغط على أي يوم سبت في الرزنامة للتحقق من المواعيد." />
        </span>
        <a href="/#meeting" class="font-bold text-cedar-800 hover:text-cedar-950 underline">
          <T en="Meeting Location Map →" ar="خريطة موقع اللقاء ←" />
        </a>
      </div>

    </div>

  </div>
</div>

<script>
  interface MonthDef {
    name: string;
    year: number;
    startDayOfWeek: number;
    totalDays: number;
  }

  const monthsData: MonthDef[] = [
    { name: "April", year: 2026, startDayOfWeek: 3, totalDays: 30 },
    { name: "May", year: 2026, startDayOfWeek: 5, totalDays: 31 },
    { name: "June", year: 2026, startDayOfWeek: 1, totalDays: 30 },
    { name: "July", year: 2026, startDayOfWeek: 3, totalDays: 31 },
    { name: "August", year: 2026, startDayOfWeek: 6, totalDays: 31 },
    { name: "September", year: 2026, startDayOfWeek: 2, totalDays: 30 },
    { name: "October", year: 2026, startDayOfWeek: 4, totalDays: 31 },
  ];

  let currentMonthIndex = 1; // Starts at May 2026

  const root = document.getElementById('troop-calendar-root');
  const phoneRaw = root?.getAttribute('data-phone') || '96170000000';
  const monthTitle = document.getElementById('cal-month-title');
  const daysGrid = document.getElementById('calendar-days-grid');
  const spotlightCard = document.getElementById('event-spotlight-card');
  const prevBtn = document.getElementById('cal-prev-btn');
  const nextBtn = document.getElementById('cal-next-btn');

  function renderCalendar() {
    const currentMonth = monthsData[currentMonthIndex];
    if (!currentMonth || !daysGrid || !monthTitle) return;

    monthTitle.textContent = `${currentMonth.name} ${currentMonth.year}`;
    daysGrid.innerHTML = '';

    // Leading empty cells
    for (let i = 0; i < currentMonth.startDayOfWeek; i++) {
      const emptyCell = document.createElement('div');
      emptyCell.className = 'py-2 text-stone-300 select-none';
      daysGrid.appendChild(emptyCell);
    }

    let firstSaturday = 0;

    // Numbered days
    for (let day = 1; day <= currentMonth.totalDays; day++) {
      const dayOfWeek = (currentMonth.startDayOfWeek + day - 1) % 7;
      const isSaturday = dayOfWeek === 6;

      if (isSaturday && firstSaturday === 0) {
        firstSaturday = day;
      }

      const dayCell = document.createElement('button');
      dayCell.type = 'button';
      dayCell.className = 'py-2 px-1 rounded-xl relative flex flex-col items-center justify-center transition-all cursor-pointer focus:outline-none';

      if (isSaturday) {
        dayCell.className += ' text-emerald-900 font-black bg-emerald-100 hover:bg-emerald-200 border border-emerald-300 shadow-sm';
        dayCell.innerHTML = `<span>${day}</span><span class="w-1.5 h-1.5 rounded-full bg-emerald-600 mt-0.5"></span>`;
        dayCell.addEventListener('click', () => {
          renderSaturdaySpotlight(day, currentMonth.name, currentMonth.year);
        });
      } else {
        dayCell.className += ' text-stone-600 hover:bg-stone-200/60';
        dayCell.innerHTML = `<span>${day}</span>`;
      }

      daysGrid.appendChild(dayCell);
    }

    if (firstSaturday > 0) {
      renderSaturdaySpotlight(firstSaturday, currentMonth.name, currentMonth.year);
    }
  }

  function renderSaturdaySpotlight(day: number, monthName: string, year: number) {
    if (!spotlightCard) return;
    spotlightCard.innerHTML = `
      <div class="flex items-center justify-between">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-emerald-700 text-white">
          Weekly Gathering • لقاء أسبوعي
        </span>
        <span class="text-xs font-bold text-stone-600 bg-stone-100 px-2.5 py-0.5 rounded-full border border-stone-200">
          Saturday, ${monthName} ${day}, ${year}
        </span>
      </div>

      <div>
        <h3 class="text-2xl font-black text-stone-900 tracking-tight leading-snug">
          Saturday Scout Gathering (اللقاء الأسبوعي)
        </h3>
        <p class="text-xs font-semibold text-emerald-800 mt-1">3:00 PM – 4:30 PM • Saint Jean Marc Courtyard, Byblos</p>
      </div>

      <p class="text-stone-600 text-sm leading-relaxed">
        Weekly gathering for all three branches: Louveteaux & Jeannettes (جراميز وزهرات, ages 4–11), Scouts & Guides (كشافة ومرشدات, ages 11–16), and Routiers & Caravelles (جوالة ومنجدات, ages 16–24). Outdoor games, woodcraft skills, character growth, and team spirit.
      </p>

      <div class="pt-4 border-t border-stone-200 flex flex-col sm:flex-row items-center justify-between gap-3">
        <a 
          href="/events/weekly-saturday-meeting" 
          class="btn-scout-gold text-xs !py-2.5 !px-5 w-full sm:w-auto text-center font-bold"
        >
          View Full Routine & Kit Checklist →
        </a>
        <a 
          href="https://wa.me/${phoneRaw}?text=${encodeURIComponent(`Hello! I have a question about attending the Saturday scout meeting on ${monthName} ${day}.`)}"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-bold text-emerald-800 hover:text-emerald-950 underline"
        >
          Ask on WhatsApp
        </a>
      </div>
    `;
  }

  prevBtn?.addEventListener('click', () => {
    if (currentMonthIndex > 0) {
      currentMonthIndex--;
      renderCalendar();
    }
  });

  nextBtn?.addEventListener('click', () => {
    if (currentMonthIndex < monthsData.length - 1) {
      currentMonthIndex++;
      renderCalendar();
    }
  });

  // Initialize immediately
  renderCalendar();
  document.addEventListener('astro:page-load', renderCalendar);
</script>
