---
import { siteConfig } from '../data/siteConfig';
import { MapPin, Clock, ArrowRight } from 'lucide-astro';
import T from './T.astro';
---

<div class="rounded-3xl bg-white border border-stone-200 p-5 sm:p-10 lg:p-12 text-center max-w-2xl mx-auto shadow-sm">
  <div class="space-y-4">
    <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center mx-auto">
      <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.54 2.112.822 3.19.822 3.181 0 5.767-2.587 5.768-5.766.001-3.182-2.585-5.768-5.768-5.768zm0-2c4.284 0 7.768 3.484 7.768 7.768 0 4.283-3.484 7.767-7.768 7.768-1.328 0-2.585-.341-3.69-.941l-4.341 1.139 1.159-4.238c-.684-1.161-1.096-2.502-1.096-3.727 0-4.284 3.484-7.768 7.768-7.768z"/>
      </svg>
    </div>

    <h3 class="text-2xl sm:text-3xl font-black text-stone-900 tracking-tight">
      <T en="Have a question or planning to visit?" ar="هل لديكم أي استفسار أو تخططون لزيارتنا؟" />
    </h3>

    <p class="text-sm text-stone-600 leading-relaxed max-w-lg mx-auto">
      <T 
        en="Whether you want to confirm meeting times, ask about unit placement for your child, or just say hello—send a WhatsApp message to our leaders." 
        ar="سواء كنتم ترغبون بالتأكد من المواعيد، أو معرفة القسم الأنسب لطفلكم، أو إلقاء التحية—يسعد قادتنا استقبال رسالتكم عبر واتساب." 
      />
    </p>

    <!-- Direct WhatsApp CTA Button -->
    <div class="pt-2">
      <a 
        href={`https://wa.me/${siteConfig.contact.phoneRaw}?text=${encodeURIComponent(siteConfig.contact.whatsappMessage)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-5 sm:px-6 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs sm:text-sm shadow-sm transition-all hover:scale-105 w-full sm:w-auto text-center"
      >
        <span class="lang-en">Message Us on WhatsApp ({siteConfig.contact.phoneDisplay})</span>
        <span class="lang-ar">راسل قادتنا على واتساب ({siteConfig.contact.phoneDisplay})</span>
        <ArrowRight class="w-4 h-4 rtl:rotate-180" />
      </a>
    </div>

    <!-- Quiet Location / Time Note -->
    <div class="pt-6 border-t border-stone-100 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-stone-500">
      <span class="flex items-center gap-1.5">
        <MapPin class="w-3.5 h-3.5 text-stone-400" />
        <T en="UNESCO Se7a, Byblos" ar="ساحة بيبلوس الأثرية، جبيل" />
      </span>
      <span class="flex items-center gap-1.5">
        <Clock class="w-3.5 h-3.5 text-stone-400" />
        <T en="Saturdays 3:00 – 4:30 PM" ar="كل سبت ٣:٠٠ – ٤:٣٠ بعد الظهر" />
      </span>
    </div>
  </div>
</div>
