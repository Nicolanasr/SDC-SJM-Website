---
import T from './T.astro';
import { galleryAlbums, galleryPhotos } from '../data/gallery';

// Directly synchronized with the central gallery database
const summerCampAlbum = galleryAlbums.find(a => a.id === 'summer-camps') || galleryAlbums[0];
const hikesAlbum = galleryAlbums.find(a => a.id === 'hikes-expeditions') || galleryAlbums[1];
const parishAlbum = galleryAlbums.find(a => a.id === 'parish-ceremonies') || galleryAlbums[3];
const pioneeringAlbum = galleryAlbums.find(a => a.id === 'pioneering') || galleryAlbums[1];

const mainPhoto = galleryPhotos.find(p => p.id === 'sc-1') || galleryPhotos[0];
const topRight1Photo = galleryPhotos.find(p => p.albumId === 'hikes-expeditions') || galleryPhotos[1];
const topRight2Photo = galleryPhotos.find(p => p.albumId === 'parish-ceremonies') || galleryPhotos[2];

const bottomRow = [
  {
    photo: galleryPhotos.find(p => p.id === 'sc-2') || galleryPhotos[1],
    album: summerCampAlbum,
  },
  {
    photo: galleryPhotos.find(p => p.id === 'pion-1') || galleryPhotos[2],
    album: pioneeringAlbum,
  },
  {
    photo: galleryPhotos.find(p => p.id === 'hike-2') || galleryPhotos[3],
    album: hikesAlbum,
  },
  {
    photo: galleryPhotos.find(p => p.id === 'sc-3') || galleryPhotos[4],
    album: summerCampAlbum,
  },
];
---

<section class="py-12 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 sm:gap-4 mb-6 sm:mb-8">
    <div>
      <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black text-stone-900 tracking-tight">
        <T en="This is what adventure looks like" ar="هكذا تبدو المغامرة الكشفية الحقيقية" />
      </h2>
      <p class="text-stone-600 text-sm sm:text-base mt-1">
        <T en="Click any photo to open its respective scout album collection." ar="اضغط على أي صورة لتصفح ألبوم الصور الخاص بها." />
      </p>
    </div>

    <a 
      href="/gallery" 
      class="text-xs font-bold uppercase tracking-wider text-cedar-800 hover:text-cedar-950 underline self-start sm:self-auto"
    >
      <T en="Browse all albums →" ar="تصفح جميع الألبومات ←" />
    </a>
  </div>

  <!-- Synchronized Collage Grid -->
  <div class="space-y-3 sm:space-y-6">
    
    <!-- Top Row: Big Main Photo on Left + 2 Stacked Photos on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-3 sm:gap-6 items-stretch">
      
      <!-- Big Focal Photo (Left ~58%) -> Opens Grand Summer Camps Album -->
      <a 
        href={`/gallery/${summerCampAlbum.id}`} 
        class="lg:col-span-7 group relative rounded-2xl sm:rounded-3xl overflow-hidden bg-stone-200 border border-stone-200 shadow-sm aspect-[4/3] lg:aspect-auto lg:min-h-[460px] block"
      >
        <img 
          src={mainPhoto.imageUrl} 
          alt={mainPhoto.title} 
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-stone-950/80 via-transparent to-transparent flex items-end p-4 sm:p-6 text-white">
          <div class="w-full flex items-end justify-between">
            <div>
              <span class="inline-block px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-amber-600 text-white mb-1.5 shadow-sm">
                <T en={`Album: ${summerCampAlbum.name}`} ar={`ألبوم: ${summerCampAlbum.nameAr}`} />
              </span>
              <div class="font-bold text-lg">
                <T en={mainPhoto.title} ar={mainPhoto.titleAr} />
              </div>
            </div>
            <span class="text-xs font-bold uppercase tracking-wider underline group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform flex items-center gap-1">
              <T en="View Album →" ar="عرض الألبوم ←" />
            </span>
          </div>
        </div>
      </a>

      <!-- Stacked 2 Photos (Right ~42%) -->
      <div class="lg:col-span-5 flex flex-col gap-3 sm:gap-6 justify-between">
        
        <!-- Top Right 1 -> Opens Hikes Album -->
        <a 
          href={`/gallery/${hikesAlbum.id}`} 
          class="group relative rounded-2xl sm:rounded-3xl overflow-hidden bg-stone-200 border border-stone-200 shadow-sm aspect-[16/9] lg:aspect-auto flex-1 block"
        >
          <img 
            src={topRight1Photo.imageUrl} 
            alt={topRight1Photo.title} 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/80 via-transparent to-transparent flex items-end p-3.5 sm:p-5 text-white">
            <div class="w-full flex items-end justify-between">
              <div>
                <span class="inline-block px-2 py-0.5 rounded-full text-[9px] sm:text-[10px] font-bold uppercase tracking-wider bg-amber-600 text-white mb-1">
                  <T en={`Album: ${hikesAlbum.name}`} ar={`ألبوم: ${hikesAlbum.nameAr}`} />
                </span>
                <div class="font-bold text-sm sm:text-base">
                  <T en={topRight1Photo.title} ar={topRight1Photo.titleAr} />
                </div>
              </div>
              <span class="text-xs font-bold uppercase tracking-wider underline group-hover:translate-x-1 transition-transform">
                →
              </span>
            </div>
          </div>
        </a>

        <!-- Top Right 2 -> Opens Parish Ceremonies Album -->
        <a 
          href={`/gallery/${parishAlbum.id}`} 
          class="group relative rounded-2xl sm:rounded-3xl overflow-hidden bg-stone-200 border border-stone-200 shadow-sm aspect-[16/9] lg:aspect-auto flex-1 block"
        >
          <img 
            src={topRight2Photo.imageUrl} 
            alt={topRight2Photo.title} 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/80 via-transparent to-transparent flex items-end p-3.5 sm:p-5 text-white">
            <div class="w-full flex items-end justify-between">
              <div>
                <span class="inline-block px-2 py-0.5 rounded-full text-[9px] sm:text-[10px] font-bold uppercase tracking-wider bg-amber-600 text-white mb-1">
                  <T en={`Album: ${parishAlbum.name}`} ar={`ألبوم: ${parishAlbum.nameAr}`} />
                </span>
                <div class="font-bold text-sm sm:text-base">
                  <T en={topRight2Photo.title} ar={topRight2Photo.titleAr} />
                </div>
              </div>
              <span class="text-xs font-bold uppercase tracking-wider underline group-hover:translate-x-1 transition-transform">
                →
              </span>
            </div>
          </div>
        </a>

      </div>

    </div>

    <!-- Bottom Row: 4 Photos Across the Width -> Derived directly from gallery.ts -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-6">
      {bottomRow.map(item => (
        <a 
          href={`/gallery/${item.album.id}`} 
          class="group relative rounded-2xl sm:rounded-3xl overflow-hidden bg-stone-200 border border-stone-200 shadow-sm aspect-[4/3] block"
        >
          <img 
            src={item.photo.imageUrl} 
            alt={item.photo.title} 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/85 via-transparent to-transparent opacity-90 group-hover:opacity-100 transition-opacity flex items-end p-2.5 sm:p-4 text-white">
            <div class="w-full">
              <span class="inline-block text-[9px] font-bold uppercase tracking-wider text-amber-300">
                <T en={item.album.name} ar={item.album.nameAr} />
              </span>
              <div class="font-bold text-xs sm:text-sm line-clamp-1">
                <T en={item.photo.title} ar={item.photo.titleAr} /> →
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>

</section>
