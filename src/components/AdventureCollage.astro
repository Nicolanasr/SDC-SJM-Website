---
import T from './T.astro';

// Collage photos mapped to their respective album routes
const collage = {
  main: {
    src: "https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=1200&q=80",
    alt: "Scouts gathered around evening campfire",
    title: "Campfire Circle Under the Stars",
    albumName: "Grand Summer Camps",
    albumHref: "/gallery/summer-camps",
  },
  topRight1: {
    src: "https://images.unsplash.com/photo-1551632811-561732d1e306?auto=format&fit=crop&w=1000&q=80",
    alt: "Mountain summit trek",
    title: "Ridge Hike Expedition",
    albumName: "Hikes & Mountain Trails",
    albumHref: "/gallery/hikes-expeditions",
  },
  topRight2: {
    src: "https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=1000&q=80",
    alt: "Scout assembly in courtyard",
    title: "Saint Jean Marc Ceremony",
    albumName: "Saint Jean Marc & Ceremonies",
    albumHref: "/gallery/parish-ceremonies",
  },
  bottomRow: [
    {
      src: "https://images.unsplash.com/photo-1510312305653-8ed496efae75?auto=format&fit=crop&w=600&q=80",
      alt: "Canvas tents in forest",
      title: "Wilderness Bivouac",
      albumName: "Summer Camps",
      albumHref: "/gallery/summer-camps",
    },
    {
      src: "https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?auto=format&fit=crop&w=600&q=80",
      alt: "Pioneering timber watchtower",
      title: "Watchtower Woodcraft",
      albumName: "Froissartage",
      albumHref: "/gallery/pioneering",
    },
    {
      src: "https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=600&q=80",
      alt: "Scout mountain trek",
      title: "Mountain Trail Crossing",
      albumName: "Hikes",
      albumHref: "/gallery/hikes-expeditions",
    },
    {
      src: "https://images.unsplash.com/photo-1496080174650-637e3f22fa03?auto=format&fit=crop&w=600&q=80",
      alt: "Outdoor campfire cooking",
      title: "Camp Cookout",
      albumName: "Pioneering",
      albumHref: "/gallery/pioneering",
    },
  ],
};
---

<section class="py-20 sm:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
    <div>
      <h2 class="text-3xl sm:text-5xl font-black text-stone-900 tracking-tight">
        <T en="This is what adventure looks like" ar="هكذا تبدو المغامرة الكشفية الحقيقية" />
      </h2>
      <p class="text-stone-600 text-sm sm:text-base mt-1">
        <T en="Click any photo to open its respective scout album collection." ar="اضغط على أي صورة لتصفح ألبوم الصور الخاص بها." />
      </p>
    </div>

    <a 
      href="/gallery" 
      class="text-xs font-bold uppercase tracking-wider text-cedar-800 hover:text-cedar-950 underline self-start sm:self-auto"
    >
      <T en="Browse all albums →" ar="تصفح جميع الألبومات ←" />
    </a>
  </div>

  <!-- Exact Collage Grid Matching media_1792751517669.jpg -->
  <div class="space-y-4 sm:space-y-6">
    
    <!-- Top Row: Big Main Photo on Left + 2 Stacked Photos on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6 items-stretch">
      
      <!-- Big Focal Photo (Left ~58%) -> Opens Grand Summer Camps Album -->
      <a 
        href={collage.main.albumHref} 
        class="lg:col-span-7 group relative rounded-3xl overflow-hidden bg-stone-200 border border-stone-200 shadow-sm aspect-[4/3] lg:aspect-auto lg:min-h-[460px] block"
      >
        <img 
          src={collage.main.src} 
          alt={collage.main.alt} 
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-stone-950/80 via-transparent to-transparent flex items-end p-6 text-white">
          <div class="w-full flex items-end justify-between">
            <div>
              <span class="inline-block px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-amber-600 text-white mb-1.5 shadow-sm">
                Album: {collage.main.albumName}
              </span>
              <div class="font-bold text-lg">{collage.main.title}</div>
            </div>
            <span class="text-xs font-bold uppercase tracking-wider underline group-hover:translate-x-1 transition-transform flex items-center gap-1">
              <span>View Album</span>
              <span>→</span>
            </span>
          </div>
        </div>
      </a>

      <!-- Stacked 2 Photos (Right ~42%) -->
      <div class="lg:col-span-5 flex flex-col gap-4 sm:gap-6 justify-between">
        
        <!-- Top Right 1 -> Opens Hikes Album -->
        <a 
          href={collage.topRight1.albumHref} 
          class="group relative rounded-3xl overflow-hidden bg-stone-200 border border-stone-200 shadow-sm aspect-[16/9] lg:aspect-auto flex-1 block"
        >
          <img 
            src={collage.topRight1.src} 
            alt={collage.topRight1.alt} 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/80 via-transparent to-transparent flex items-end p-5 text-white">
            <div class="w-full flex items-end justify-between">
              <div>
                <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-600 text-white mb-1">
                  Album: {collage.topRight1.albumName}
                </span>
                <div class="font-bold text-base">{collage.topRight1.title}</div>
              </div>
              <span class="text-xs font-bold uppercase tracking-wider underline group-hover:translate-x-1 transition-transform">
                →
              </span>
            </div>
          </div>
        </a>

        <!-- Top Right 2 -> Opens Parish Ceremonies Album -->
        <a 
          href={collage.topRight2.albumHref} 
          class="group relative rounded-3xl overflow-hidden bg-stone-200 border border-stone-200 shadow-sm aspect-[16/9] lg:aspect-auto flex-1 block"
        >
          <img 
            src={collage.topRight2.src} 
            alt={collage.topRight2.alt} 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/80 via-transparent to-transparent flex items-end p-5 text-white">
            <div class="w-full flex items-end justify-between">
              <div>
                <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-600 text-white mb-1">
                  Album: {collage.topRight2.albumName}
                </span>
                <div class="font-bold text-base">{collage.topRight2.title}</div>
              </div>
              <span class="text-xs font-bold uppercase tracking-wider underline group-hover:translate-x-1 transition-transform">
                →
              </span>
            </div>
          </div>
        </a>

      </div>

    </div>

    <!-- Bottom Row: 4 Photos Across the Width -> Each opens its respective album -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {collage.bottomRow.map(item => (
        <a 
          href={item.albumHref} 
          class="group relative rounded-2xl sm:rounded-3xl overflow-hidden bg-stone-200 border border-stone-200 shadow-sm aspect-[4/3] block"
        >
          <img 
            src={item.src} 
            alt={item.alt} 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/85 via-transparent to-transparent opacity-90 group-hover:opacity-100 transition-opacity flex items-end p-3.5 sm:p-4 text-white">
            <div class="w-full">
              <span class="inline-block text-[9px] font-bold uppercase tracking-wider text-amber-300">
                {item.albumName}
              </span>
              <div class="font-bold text-xs sm:text-sm line-clamp-1">{item.title} →</div>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>

</section>
