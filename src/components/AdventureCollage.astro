---
import T from './T.astro';
import { galleryAlbums, galleryPhotos } from '../data/gallery';

// Directly synchronized with the central gallery database
const summerCampAlbum = galleryAlbums.find(a => a.id === 'summer-camps') || galleryAlbums[0];
const hikesAlbum = galleryAlbums.find(a => a.id === 'hikes-expeditions') || galleryAlbums[1];
const parishAlbum = galleryAlbums.find(a => a.id === 'parish-ceremonies') || galleryAlbums[3];
const pioneeringAlbum = galleryAlbums.find(a => a.id === 'pioneering') || galleryAlbums[1];

const mainPhoto = galleryPhotos.find(p => p.id === 'sc-1') || galleryPhotos[0];
const topRight1Photo = galleryPhotos.find(p => p.albumId === 'hikes-expeditions') || galleryPhotos[1];
const topRight2Photo = galleryPhotos.find(p => p.albumId === 'parish-ceremonies') || galleryPhotos[2];

const bottomRow = [
  {
    photo: galleryPhotos.find(p => p.id === 'sc-2') || galleryPhotos[1],
    album: summerCampAlbum,
    tag: "High Ridge Camp",
    tagAr: "مخيم المرتفعات",
    rotation: "sm:-rotate-1",
  },
  {
    photo: galleryPhotos.find(p => p.id === 'pion-1') || galleryPhotos[2],
    album: pioneeringAlbum,
    tag: "Zero Nails",
    tagAr: "بدون مسامير",
    rotation: "sm:rotate-1",
  },
  {
    photo: galleryPhotos.find(p => p.id === 'hike-2') || galleryPhotos[3],
    album: hikesAlbum,
    tag: "Valley Trail",
    tagAr: "درب الوادي",
    rotation: "sm:-rotate-0.5",
  },
  {
    photo: galleryPhotos.find(p => p.id === 'sc-3') || galleryPhotos[4],
    album: summerCampAlbum,
    tag: "Campfire Lore",
    tagAr: "سهرة النار",
    rotation: "sm:rotate-1.5",
  },
];
---

<section class="py-12 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 sm:gap-4 mb-8 sm:mb-12">
    <div>
      <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-800 mb-1">
        <span class="w-2 h-2 rounded-full bg-amber-600"></span>
        <span><T en="FIELD MEMORIES & LOGS" ar="سجل الذكريات والميدان" /></span>
      </div>
      <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black text-stone-900 tracking-tight">
        <T en="This is what adventure looks like." ar="هكذا تبدو المغامرة الكشفية الحقيقية." />
      </h2>
      <p class="text-stone-600 text-sm sm:text-base mt-1.5 max-w-xl">
        <T 
          en="Unposed, real moments from Lebanese cedar ridges, campfires, and the streets of Byblos. Click any memory to open its album." 
          ar="لحظات عفوية حقيقية من جبال الأرز وسهرات النار وأزقة جبيل. اضغط على أي ذكرى لتصفح ألبومها الكامل." 
        />
      </p>
    </div>

    <a 
      href="/gallery" 
      class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-cedar-800 hover:text-cedar-950 underline self-start sm:self-auto"
    >
      <T en="Browse all albums →" ar="تصفح جميع الألبومات ←" />
    </a>
  </div>

  <!-- Organic Scout Scrapbook / Field Wall Layout -->
  <div class="space-y-5 sm:space-y-8">
    
    <!-- Top Asymmetric Section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-8 items-stretch">
      
      <!-- Big Focal Photo with Masking Tape Accent -->
      <div class="lg:col-span-7 relative group">
        <!-- Masking tape stamp top-center -->
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 z-20 w-24 h-5 bg-amber-100/90 border border-amber-300/70 shadow-xs -rotate-2 pointer-events-none backdrop-blur-xs"></div>
        
        <a 
          href={`/gallery/${summerCampAlbum.id}`} 
          class="block h-full relative rounded-2xl sm:rounded-3xl overflow-hidden bg-stone-900 border-2 border-stone-200/80 shadow-md group-hover:shadow-xl transition-all duration-300 group-hover:-translate-y-1 aspect-[4/3] lg:aspect-auto lg:min-h-[460px]"
        >
          <img 
            src={mainPhoto.imageUrl} 
            alt={mainPhoto.title} 
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-90 group-hover:opacity-100"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/85 via-stone-950/20 to-transparent flex items-end p-5 sm:p-7 text-white">
            <div class="w-full flex items-end justify-between gap-4">
              <div class="space-y-1">
                <span class="inline-block px-2.5 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider bg-amber-600 text-white shadow-xs">
                  <T en={`Album: ${summerCampAlbum.name}`} ar={`ألبوم: ${summerCampAlbum.nameAr}`} />
                </span>
                <div class="font-serif text-lg sm:text-2xl font-bold tracking-tight">
                  <T en={mainPhoto.title} ar={mainPhoto.titleAr} />
                </div>
                <div class="text-xs text-amber-300/90 font-mono">
                  <T en="Qadisha High Plateau • Summer Camp" ar="أعالي وادي قاديشا • المخيم الصيفي" />
                </div>
              </div>
              <span class="text-xs font-bold uppercase tracking-wider underline group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform shrink-0">
                <T en="Open →" ar="عرض ←" />
              </span>
            </div>
          </div>
        </a>
      </div>

      <!-- Right Column: 2 Asymmetrical Cards -->
      <div class="lg:col-span-5 flex flex-col gap-5 sm:gap-6 justify-between">
        
        <!-- Top Right: Polaroid / Field-card look -->
        <div class="relative group flex-1">
          <a 
            href={`/gallery/${hikesAlbum.id}`} 
            class="block h-full relative rounded-2xl sm:rounded-3xl overflow-hidden bg-white p-2.5 sm:p-3 border-2 border-stone-200 shadow-sm group-hover:shadow-lg transition-all duration-300 group-hover:-translate-y-0.5 sm:rotate-1 group-hover:rotate-0 flex flex-col"
          >
            <div class="relative rounded-xl overflow-hidden aspect-[16/10] bg-stone-900">
              <img 
                src={topRight1Photo.imageUrl} 
                alt={topRight1Photo.title} 
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-md text-[9px] font-bold uppercase tracking-wider bg-stone-900/80 text-amber-300 backdrop-blur-sm">
                <T en="Mountain Trek" ar="مسار جبلي" />
              </span>
            </div>
            <div class="pt-2.5 px-1 pb-1 flex items-center justify-between">
              <div>
                <h4 class="font-serif text-sm sm:text-base font-bold text-stone-900">
                  <T en={topRight1Photo.title} ar={topRight1Photo.titleAr} />
                </h4>
                <p class="text-[11px] text-stone-500">
                  <T en={`Album: ${hikesAlbum.name}`} ar={`ألبوم: ${hikesAlbum.nameAr}`} />
                </p>
              </div>
              <span class="text-xs font-bold text-emerald-800 underline">→</span>
            </div>
          </a>
        </div>

        <!-- Top Right 2: Dark Woodsy Card -->
        <div class="relative group flex-1">
          <a 
            href={`/gallery/${parishAlbum.id}`} 
            class="block h-full relative rounded-2xl sm:rounded-3xl overflow-hidden bg-stone-900 border-2 border-stone-800 shadow-sm group-hover:shadow-lg transition-all duration-300 group-hover:-translate-y-0.5 sm:-rotate-0.5 group-hover:rotate-0 aspect-[16/9] lg:aspect-auto"
          >
            <img 
              src={topRight2Photo.imageUrl} 
              alt={topRight2Photo.title} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-85 group-hover:opacity-95"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-stone-950/90 via-stone-950/30 to-transparent flex items-end p-4 text-white">
              <div class="w-full flex items-end justify-between">
                <div>
                  <span class="inline-block px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-gold-500 text-stone-950 mb-1">
                    <T en={`Album: ${parishAlbum.name}`} ar={`ألبوم: ${parishAlbum.nameAr}`} />
                  </span>
                  <div class="font-serif text-sm sm:text-base font-bold text-white">
                    <T en={topRight2Photo.title} ar={topRight2Photo.titleAr} />
                  </div>
                </div>
                <span class="text-xs font-bold text-amber-300">→</span>
              </div>
            </div>
          </a>
        </div>

      </div>

    </div>

    <!-- Bottom Row: Asymmetrical Organic Cards with Field Badges -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-6">
      {bottomRow.map(item => (
        <a 
          href={`/gallery/${item.album.id}`} 
          class={`group relative rounded-2xl sm:rounded-3xl overflow-hidden bg-stone-900 border-2 border-stone-200/80 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 ${item.rotation} hover:rotate-0 block aspect-[4/3] sm:aspect-[3/4] lg:aspect-[4/5]`}
        >
          <img 
            src={item.photo.imageUrl} 
            alt={item.photo.title} 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-90 group-hover:opacity-100"
            loading="lazy"
          />
          
          <!-- Field Badge in Top Corner -->
          <div class="absolute top-2.5 left-2.5 rtl:left-auto rtl:right-2.5">
            <span class="inline-block px-2 py-0.5 rounded-md text-[9px] font-bold uppercase tracking-wider bg-stone-900/85 text-amber-300 backdrop-blur-xs border border-white/10">
              <T en={item.tag} ar={item.tagAr} />
            </span>
          </div>

          <!-- Bottom Caption Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/90 via-transparent to-transparent opacity-95 group-hover:opacity-100 transition-opacity flex items-end p-3 sm:p-4 text-white">
            <div class="w-full">
              <span class="inline-block text-[9px] font-bold uppercase tracking-wider text-amber-400">
                <T en={item.album.name} ar={item.album.nameAr} />
              </span>
              <div class="font-serif text-xs sm:text-sm font-bold line-clamp-2">
                <T en={item.photo.title} ar={item.photo.titleAr} />
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>

</section>
