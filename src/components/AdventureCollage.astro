---
import T from './T.astro';
import { galleryAlbums, galleryPhotos } from '../data/gallery';

// Directly synchronized with the central gallery database
const summerCampAlbum = galleryAlbums.find(a => a.id === 'summer-camps') || galleryAlbums[0];
const hikesAlbum = galleryAlbums.find(a => a.id === 'hikes-expeditions') || galleryAlbums[1];
const parishAlbum = galleryAlbums.find(a => a.id === 'parish-ceremonies') || galleryAlbums[3];
const pioneeringAlbum = galleryAlbums.find(a => a.id === 'pioneering') || galleryAlbums[1];

const mainPhoto = galleryPhotos.find(p => p.id === 'sc-1') || galleryPhotos[0];
const topRight1Photo = galleryPhotos.find(p => p.albumId === 'hikes-expeditions') || galleryPhotos[1];
const topRight2Photo = galleryPhotos.find(p => p.albumId === 'parish-ceremonies') || galleryPhotos[2];

const bottomRow = [
  {
    photo: galleryPhotos.find(p => p.id === 'sc-2') || galleryPhotos[1],
    album: summerCampAlbum,
    tag: "High Ridge Camp",
    tagAr: "مخيم المرتفعات",
    rotation: "sm:-rotate-1",
  },
  {
    photo: galleryPhotos.find(p => p.id === 'pion-1') || galleryPhotos[2],
    album: pioneeringAlbum,
    tag: "Zero Nails",
    tagAr: "بدون مسامير",
    rotation: "sm:rotate-1",
  },
  {
    photo: galleryPhotos.find(p => p.id === 'hike-2') || galleryPhotos[3],
    album: hikesAlbum,
    tag: "Valley Trail",
    tagAr: "درب الوادي",
    rotation: "sm:-rotate-0.5",
  },
  {
    photo: galleryPhotos.find(p => p.id === 'sc-3') || galleryPhotos[4],
    album: summerCampAlbum,
    tag: "Campfire Lore",
    tagAr: "سهرة النار",
    rotation: "sm:rotate-1.5",
  },
];
---

<section class="py-12 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 sm:gap-4 mb-8 sm:mb-12">
    <div>
      <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-800 mb-1">
        <span class="w-2 h-2 rounded-full bg-amber-600"></span>
        <span><T en="FIELD MEMORIES & LOGS" ar="سجل الذكريات والميدان" /></span>
      </div>
      <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black text-stone-900 tracking-tight">
        <T en="This is what adventure looks like." ar="هكذا تبدو المغامرة الكشفية الحقيقية." />
      </h2>
      <p class="text-stone-600 text-sm sm:text-base mt-1.5 max-w-xl">
        <T 
          en="Unposed, real moments from Lebanese cedar ridges, campfires, and the streets of Byblos. Click any memory to open its album." 
          ar="لحظات عفوية حقيقية من جبال الأرز وسهرات النار وأزقة جبيل. اضغط على أي ذكرى لتصفح ألبومها الكامل." 
        />
      </p>
    </div>

    <a 
      href="/gallery" 
      class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-cedar-800 hover:text-cedar-950 underline self-start sm:self-auto"
    >
      <T en="Browse all albums →" ar="تصفح جميع الألبومات ←" />
    </a>
  </div>

  <!-- Organic Scout Scrapbook / Field Wall Layout with Varied Sizes -->
  <div class="space-y-6 sm:space-y-10">
    
    <!-- Top Section: Asymmetric Focal + Polaroid Card -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-center">
      
      <!-- Card 1: Wide High-Ridge Camp (Cinematic Scrapbook Hero) -->
      <div class="lg:col-span-7 relative group sm:-rotate-1 hover:rotate-0 transition-transform duration-300">
        <!-- Masking tape strip top-center -->
        <div class="absolute -top-3 left-1/3 -translate-x-1/2 z-20 w-28 h-6 bg-amber-100/90 border border-amber-300/60 shadow-xs -rotate-3 pointer-events-none backdrop-blur-xs"></div>
        
        <a 
          href={`/gallery/${summerCampAlbum.id}`} 
          class="block relative rounded-2xl sm:rounded-3xl overflow-hidden bg-stone-900 border-2 border-stone-200/90 shadow-md group-hover:shadow-2xl transition-all duration-300 group-hover:-translate-y-1 aspect-[16/10] sm:aspect-[16/10]"
        >
          <img 
            src={mainPhoto.imageUrl} 
            alt={mainPhoto.title} 
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-90 group-hover:opacity-100"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/90 via-stone-950/20 to-transparent flex items-end p-5 sm:p-7 text-white">
            <div class="w-full flex items-end justify-between gap-4">
              <div class="space-y-1.5">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider bg-amber-600 text-white shadow-xs">
                  <T en={`Album: ${summerCampAlbum.name}`} ar={`ألبوم: ${summerCampAlbum.nameAr}`} />
                </span>
                <div class="font-serif text-lg sm:text-2xl font-bold tracking-tight">
                  <T en={mainPhoto.title} ar={mainPhoto.titleAr} />
                </div>
                <div class="text-xs text-amber-300/90 font-mono">
                  <T en="Qadisha High Plateau • Summer Camp" ar="أعالي وادي قاديشا • المخيم الصيفي" />
                </div>
              </div>
              <span class="text-xs font-bold uppercase tracking-wider underline group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform shrink-0">
                <T en="Open Album →" ar="عرض الألبوم ←" />
              </span>
            </div>
          </div>
        </a>
      </div>

      <!-- Card 2: Authentic White Polaroid Card (Mountain Trek) -->
      <div class="lg:col-span-5 relative group sm:rotate-2 hover:rotate-0 transition-transform duration-300">
        <!-- Masking tape strip across top-right corner -->
        <div class="absolute -top-3 right-6 z-20 w-24 h-6 bg-amber-100/90 border border-amber-300/60 shadow-xs rotate-6 pointer-events-none backdrop-blur-xs"></div>

        <a 
          href={`/gallery/${hikesAlbum.id}`} 
          class="block relative rounded-2xl bg-white p-3 sm:p-4 pb-4 sm:pb-6 border border-stone-300/80 shadow-md group-hover:shadow-2xl transition-all duration-300 group-hover:-translate-y-1"
        >
          <div class="relative rounded-xl overflow-hidden aspect-[4/3] bg-stone-900">
            <img 
              src={topRight1Photo.imageUrl} 
              alt={topRight1Photo.title} 
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-md text-[9px] font-bold uppercase tracking-wider bg-stone-900/80 text-amber-300 backdrop-blur-sm">
              <T en="Valley Hike Log" ar="سجل مسير الوادي" />
            </span>
          </div>
          <div class="pt-3 px-1 flex items-baseline justify-between">
            <div>
              <h3 class="font-serif text-base sm:text-lg font-bold text-stone-900">
                <T en={topRight1Photo.title} ar={topRight1Photo.titleAr} />
              </h3>
              <p class="text-xs text-stone-500">
                <T en={`Album: ${hikesAlbum.name}`} ar={`ألبوم: ${hikesAlbum.nameAr}`} />
              </p>
            </div>
            <span class="text-xs font-bold text-cedar-800 underline">→</span>
          </div>
        </a>
      </div>

    </div>

    <!-- Bottom Section: Varied Random Sizes (Tall Portrait, Square Badge, Panoramic) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-5 sm:gap-7 items-start">
      
      <!-- Card 3: Tall Vertical Portrait (Zero Nails Pioneering) -->
      <div class="lg:col-span-4 relative group sm:-rotate-2 hover:rotate-0 transition-transform duration-300">
        <!-- Masking tape on top-left -->
        <div class="absolute -top-2.5 left-4 z-20 w-20 h-5 bg-amber-100/90 border border-amber-300/60 shadow-xs -rotate-4 pointer-events-none"></div>

        <a 
          href={`/gallery/${pioneeringAlbum.id}`} 
          class="block relative rounded-2xl sm:rounded-3xl overflow-hidden bg-stone-900 border-2 border-stone-200/90 shadow-md group-hover:shadow-2xl transition-all duration-300 group-hover:-translate-y-1 aspect-[3/4]"
        >
          <img 
            src={bottomRow[1].photo.imageUrl} 
            alt={bottomRow[1].photo.title} 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-90 group-hover:opacity-100"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute top-3 right-3">
            <span class="inline-block px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-500 text-stone-950 shadow-xs">
              <T en="Zero Nails • Froissartage" ar="ريادة خشبية • بدون مسامير" />
            </span>
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/95 via-stone-950/30 to-transparent flex items-end p-4 sm:p-5 text-white">
            <div>
              <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-amber-400">
                <T en={pioneeringAlbum.name} ar={pioneeringAlbum.nameAr} />
              </span>
              <div class="font-serif text-sm sm:text-base font-bold">
                <T en={bottomRow[1].photo.title} ar={bottomRow[1].photo.titleAr} />
              </div>
            </div>
          </div>
        </a>
      </div>

      <!-- Card 4: Compact Horizontal Scrapbook Card (Parish Processions) -->
      <div class="lg:col-span-4 relative group sm:rotate-2.5 hover:rotate-0 transition-transform duration-300">
        <!-- Masking tape centered at bottom edge -->
        <div class="absolute -top-3 right-8 z-20 w-24 h-5 bg-amber-100/90 border border-amber-300/60 shadow-xs rotate-3 pointer-events-none"></div>

        <a 
          href={`/gallery/${parishAlbum.id}`} 
          class="block relative rounded-2xl sm:rounded-3xl overflow-hidden bg-stone-900 border-2 border-stone-200/90 shadow-md group-hover:shadow-2xl transition-all duration-300 group-hover:-translate-y-1 aspect-[4/3] sm:aspect-square lg:aspect-[4/3]"
        >
          <img 
            src={topRight2Photo.imageUrl} 
            alt={topRight2Photo.title} 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-85 group-hover:opacity-100"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute top-3 left-3">
            <span class="inline-block px-2.5 py-0.5 rounded-md text-[9px] font-bold uppercase tracking-wider bg-black/70 text-amber-300 backdrop-blur-xs border border-white/10">
              <T en="Old Byblos Heritage" ar="تراث جبيل العريق" />
            </span>
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/95 via-transparent to-transparent flex items-end p-4 sm:p-5 text-white">
            <div>
              <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-gold-400">
                <T en={parishAlbum.name} ar={parishAlbum.nameAr} />
              </span>
              <div class="font-serif text-sm sm:text-base font-bold">
                <T en={topRight2Photo.title} ar={topRight2Photo.titleAr} />
              </div>
            </div>
          </div>
        </a>
      </div>

      <!-- Card 5: Wide Campfire Card with Vintage Pinboard Tape -->
      <div class="lg:col-span-4 relative group sm:-rotate-1.5 hover:rotate-0 transition-transform duration-300">
        <!-- Masking tape centered at top edge -->
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 z-20 w-24 h-6 bg-amber-100/90 border border-amber-300/60 shadow-xs -rotate-2 pointer-events-none"></div>

        <a 
          href={`/gallery/${summerCampAlbum.id}`} 
          class="block relative rounded-2xl sm:rounded-3xl overflow-hidden bg-stone-900 border-2 border-stone-200/90 shadow-md group-hover:shadow-2xl transition-all duration-300 group-hover:-translate-y-1 aspect-[4/3] sm:aspect-square lg:aspect-[4/3]"
        >
          <img 
            src={bottomRow[3].photo.imageUrl} 
            alt={bottomRow[3].photo.title} 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 opacity-90 group-hover:opacity-100"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute top-3 left-3">
            <span class="inline-block px-2.5 py-0.5 rounded-md text-[9px] font-bold uppercase tracking-wider bg-stone-900/85 text-amber-300 backdrop-blur-xs border border-white/10">
              <T en="Campfire Vigil" ar="سهرة النار" />
            </span>
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-stone-950/95 via-transparent to-transparent flex items-end p-4 sm:p-5 text-white">
            <div>
              <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-amber-400">
                <T en={bottomRow[3].album.name} ar={bottomRow[3].album.nameAr} />
              </span>
              <div class="font-serif text-sm sm:text-base font-bold">
                <T en={bottomRow[3].photo.title} ar={bottomRow[3].photo.titleAr} />
              </div>
            </div>
          </div>
        </a>
      </div>

    </div>

  </div>

</section>
