---
import { siteConfig } from '../data/siteConfig';
---

<!-- Floating WhatsApp Quick Button -->
<aside class="fixed bottom-6 right-6 z-50 group">
  <a 
    href={`https://wa.me/${siteConfig.contact.phoneRaw}?text=${encodeURIComponent(siteConfig.contact.whatsappMessage)}`}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-2.5 bg-emerald-600 hover:bg-emerald-500 text-white pl-4 pr-5 py-3 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105 border-2 border-white/20 focus:outline-none focus:ring-4 focus:ring-emerald-400/40"
    aria-label="Chat with Scout Leaders on WhatsApp"
  >
    <!-- WhatsApp Icon -->
    <div class="relative">
      <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.54 2.112.822 3.19.822 3.181 0 5.767-2.587 5.768-5.766.001-3.182-2.585-5.768-5.768-5.768zm0-2c4.284 0 7.768 3.484 7.768 7.768 0 4.283-3.484 7.767-7.768 7.768-1.328 0-2.585-.341-3.69-.941l-4.341 1.139 1.159-4.238c-.684-1.161-1.096-2.502-1.096-3.727 0-4.284 3.484-7.768 7.768-7.768z"/>
      </svg>
      <!-- Online green dot -->
      <span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-amber-400 border-2 border-emerald-600 rounded-full animate-pulse"></span>
    </div>

    <div class="text-left font-sans">
      <span class="text-xs uppercase font-extrabold tracking-wider block leading-tight">Chat with Chefs</span>
      <span class="text-[10px] text-emerald-100 font-medium block">Ask about Saturdays</span>
    </div>
  </a>
</aside>
