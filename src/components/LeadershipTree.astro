---
import { leadershipData, type LeaderNode } from '../data/leadership';
import T from './T.astro';
---

<div class="py-6 sm:py-10 max-w-6xl mx-auto px-2.5 sm:px-6">
  
  <div class="space-y-12 sm:space-y-16">
    
    <!-- LEVEL 1: Spiritual Guidance & Troop Direction -->
    <div class="space-y-4 flex flex-col items-center">
      
      <!-- Section Tag -->
      <div class="text-center">
        <span class="inline-block px-3.5 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-widest bg-stone-900 text-amber-400 border border-stone-700 shadow-sm">
          <T en="SPIRITUAL GUIDANCE & TROOP DIRECTION" ar="الإرشاد الروحي وقيادة الفوج" />
        </span>
      </div>

      <!-- Top: Mourched Al Foj (Spiritual Guidance - Smaller, Refined) -->
      <div class="w-full max-w-sm flex flex-col items-center">
        <button 
          type="button" 
          class="leader-card w-full bg-stone-50 hover:bg-white rounded-2xl p-3.5 sm:p-4 border border-amber-300/80 shadow-xs hover:shadow-md hover:border-amber-500 transition-all text-center flex flex-col justify-between cursor-pointer focus:outline-none"
          data-name={leadershipData.chaplain.name}
          data-name-ar={leadershipData.chaplain.nameAr}
          data-role={leadershipData.chaplain.role}
          data-role-ar={leadershipData.chaplain.roleAr}
          data-bio={leadershipData.chaplain.bio}
          data-bio-ar={leadershipData.chaplain.bioAr}
        >
          <div>
            <div class="w-10 h-10 rounded-full bg-stone-900 text-amber-300 mx-auto mb-2 flex items-center justify-center font-serif text-lg font-bold border border-amber-400 shadow-xs">
              ✝
            </div>
            <span class="inline-block px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-200 mb-1">
              <T en="Spiritual Guidance" ar="الإرشاد الروحي والرعوي" />
            </span>
            <h4 class="font-bold text-base sm:text-lg text-stone-900">
              <T en={leadershipData.chaplain.name} ar={leadershipData.chaplain.nameAr} />
            </h4>
            <p class="text-xs font-semibold text-amber-800 tracking-wide mt-0.5">
              <T en={leadershipData.chaplain.role} ar={leadershipData.chaplain.roleAr} />
            </p>
          </div>
          <div class="pt-2 mt-2 border-t border-stone-200/60 text-[11px] text-stone-500 font-medium">
            <T en="Click to view pastoral bio" ar="اضغط للاطلاع على السيرة الرعوية" />
          </div>
        </button>
      </div>

      <!-- Connector Line from Mourched to Chef de Groupe -->
      <div class="w-0.5 h-5 bg-amber-300"></div>

      <!-- Chef de Groupe (Operational Troop Leader) -->
      <div class="w-full max-w-sm flex flex-col items-center">
        <button 
          type="button" 
          class="leader-card w-full bg-cedar-950 text-white rounded-2xl sm:rounded-3xl p-5 border-2 border-cedar-800 shadow-md hover:shadow-xl hover:border-gold-400 transition-all text-center flex flex-col justify-between cursor-pointer focus:outline-none"
          data-name={leadershipData.groupLeader.name}
          data-name-ar={leadershipData.groupLeader.nameAr}
          data-role={leadershipData.groupLeader.role}
          data-role-ar={leadershipData.groupLeader.roleAr}
          data-bio={leadershipData.groupLeader.bio}
          data-bio-ar={leadershipData.groupLeader.bioAr}
        >
          <div>
            <div class="w-14 h-14 rounded-full bg-cedar-800 text-gold-400 mx-auto mb-3 flex items-center justify-center font-serif text-lg font-black border-2 border-gold-400 shadow-sm">
              CG
            </div>
            <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-gold-400/20 text-gold-300 border border-gold-400/30 mb-1.5">
              <T en="Troop Leader • Chef de Groupe" ar="قيادة الفوج • رئيسة الفوج" />
            </span>
            <h4 class="font-bold text-lg sm:text-xl text-white">
              <T en={leadershipData.groupLeader.name} ar={leadershipData.groupLeader.nameAr} />
            </h4>
            <p class="text-xs sm:text-sm font-semibold text-gold-300 tracking-wide mt-1">
              <T en={leadershipData.groupLeader.role} ar={leadershipData.groupLeader.roleAr} />
            </p>
          </div>
          <div class="pt-3 mt-3 border-t border-cedar-800 text-xs text-sand-300 font-medium">
            <T en="Click to view profile & bio" ar="اضغط للاطلاع على السيرة الكشفية" />
          </div>
        </button>
      </div>

      <!-- Stem Connector to Deputy Leader -->
      <div class="w-0.5 h-6 bg-stone-300"></div>

      <!-- Assistant Chef de Groupe (Deputy Leader) -->
      <div class="w-full max-w-xs flex flex-col items-center">
        <button 
          type="button" 
          class="leader-card w-full bg-white rounded-2xl p-4 border-2 border-stone-200 shadow-sm hover:shadow-md hover:border-cedar-800 transition-all text-center flex flex-col justify-between cursor-pointer focus:outline-none"
          data-name={leadershipData.deputyLeader.name}
          data-name-ar={leadershipData.deputyLeader.nameAr}
          data-role={leadershipData.deputyLeader.role}
          data-role-ar={leadershipData.deputyLeader.roleAr}
          data-bio={leadershipData.deputyLeader.bio}
          data-bio-ar={leadershipData.deputyLeader.bioAr}
        >
          <div>
            <div class="w-11 h-11 rounded-full bg-sand-200 text-cedar-950 mx-auto mb-2 flex items-center justify-center font-serif text-sm font-black border border-cedar-800 shadow-xs">
              AC
            </div>
            <h4 class="font-bold text-base sm:text-lg text-stone-900">
              <T en={leadershipData.deputyLeader.name} ar={leadershipData.deputyLeader.nameAr} />
            </h4>
            <p class="text-xs font-semibold text-cedar-800 tracking-wider mt-0.5">
              <T en={leadershipData.deputyLeader.role} ar={leadershipData.deputyLeader.roleAr} />
            </p>
          </div>
          <div class="pt-2 mt-2 border-t border-stone-100 text-[11px] text-stone-400 font-medium">
            <T en="Click to view bio" ar="اضغط للاطلاع على النبذة" />
          </div>
        </button>
      </div>

    </div>

    <!-- LEVEL 2: Maitrise de Groupe (Includes Administrative Leader + Council Members) -->
    <div class="space-y-4 pt-4 border-t border-stone-200/80">
      <div class="text-center">
        <span class="inline-block px-3.5 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-widest bg-stone-100 text-stone-800 border border-stone-300">
          <T en="MAITRISE DE GROUPE • OPERATIONAL COUNCIL" ar="مجلس الفوج • المسؤوليات الإدارية واللوجستية" />
        </span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
        {leadershipData.council.map(member => (
          <button 
            type="button" 
            class="leader-card bg-white rounded-2xl p-3.5 sm:p-4 border border-stone-200 shadow-xs hover:shadow-md hover:border-cedar-800 transition-all text-center flex flex-col justify-between cursor-pointer focus:outline-none"
            data-name={member.name}
            data-name-ar={member.nameAr}
            data-role={member.role}
            data-role-ar={member.roleAr}
            data-bio={member.bio}
            data-bio-ar={member.bioAr}
          >
            <div>
              <div class="w-11 h-11 rounded-full bg-stone-100 text-stone-800 mx-auto mb-2 flex items-center justify-center font-serif text-sm font-bold border border-stone-300">
                {member.name.replace('Chefteine ', '').replace('Chef ', '').slice(0, 2)}
              </div>
              <h5 class="font-bold text-sm sm:text-base text-stone-900 line-clamp-1">
                <T en={member.name} ar={member.nameAr} />
              </h5>
              <p class="text-xs font-semibold text-emerald-800 mt-1 line-clamp-2">
                <T en={member.role.split('(')[0].trim()} ar={member.roleAr} />
              </p>
            </div>
            <div class="pt-2 mt-2 border-t border-stone-100 text-[10px] text-stone-400 font-medium">
              <T en="View Details →" ar="عرض التفاصيل ←" />
            </div>
          </button>
        ))}
      </div>
    </div>

    <!-- LEVEL 3: The 6 Unit Branches (Louveteaux, Jeannettes, Scouts, Guides, Routiers, Caravelles) -->
    <div class="space-y-6 pt-4 border-t border-stone-200/80">
      <div class="text-center">
        <span class="inline-block px-3.5 py-1 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-widest bg-stone-100 text-stone-700 border border-stone-300">
          <T en="UNIT BRANCH LEADERSHIP" ar="قيادة الوحدات والفروع الكشفية الستة" />
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {leadershipData.units.map(unit => (
          <div class={`rounded-2xl sm:rounded-3xl p-4 sm:p-6 border-2 ${unit.color} shadow-sm space-y-4 flex flex-col justify-between bg-white`}>
            <div>
              <div class="border-b border-stone-200 pb-2 mb-3">
                <h4 class="font-black text-base sm:text-xl text-stone-900">
                  <T en={unit.title} ar={unit.titleAr} />
                </h4>
              </div>

              <!-- Chief and Assistant Side-by-side or stacked -->
              <div class="space-y-3">
                <!-- Unit Chief -->
                <button 
                  type="button" 
                  class="leader-card w-full bg-stone-50 hover:bg-stone-100 p-3 sm:p-3.5 rounded-xl border border-stone-200 text-left rtl:text-right flex items-center justify-between cursor-pointer focus:outline-none transition-colors"
                  data-name={unit.chief.name}
                  data-name-ar={unit.chief.nameAr}
                  data-role={unit.chief.role}
                  data-role-ar={unit.chief.roleAr}
                  data-bio={unit.chief.bio}
                  data-bio-ar={unit.chief.bioAr}
                >
                  <div>
                    <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-emerald-800 block">
                      <T en="Unit Chief" ar="قائد الفرع" />
                    </span>
                    <strong class="text-sm sm:text-base text-stone-900 block font-bold">
                      <T en={unit.chief.name} ar={unit.chief.nameAr} />
                    </strong>
                    <span class="text-xs text-stone-500">
                      <T en={unit.chief.role} ar={unit.chief.roleAr} />
                    </span>
                  </div>
                  <span class="text-sm text-stone-400 rtl:rotate-180">›</span>
                </button>

                <!-- Assistant -->
                <button 
                  type="button" 
                  class="leader-card w-full bg-stone-50 hover:bg-stone-100 p-3 sm:p-3.5 rounded-xl border border-stone-200 text-left rtl:text-right flex items-center justify-between cursor-pointer focus:outline-none transition-colors"
                  data-name={unit.assistant.name}
                  data-name-ar={unit.assistant.nameAr}
                  data-role={unit.assistant.role}
                  data-role-ar={unit.assistant.roleAr}
                  data-bio={unit.assistant.bio}
                  data-bio-ar={unit.assistant.bioAr}
                >
                  <div>
                    <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-amber-800 block">
                      <T en="Assistant Leader" ar="المساعد" />
                    </span>
                    <strong class="text-sm sm:text-base text-stone-900 block font-bold">
                      <T en={unit.assistant.name} ar={unit.assistant.nameAr} />
                    </strong>
                    <span class="text-xs text-stone-500">
                      <T en={unit.assistant.role} ar={unit.assistant.roleAr} />
                    </span>
                  </div>
                  <span class="text-sm text-stone-400 rtl:rotate-180">›</span>
                </button>
              </div>
            </div>

            <div class="pt-2 text-center border-t border-stone-100">
              <a 
                href={`/sections#${unit.branchId}`}
                class="text-xs font-bold text-cedar-800 hover:text-cedar-950 uppercase tracking-wider"
              >
                <T en="Explore Branch Activities →" ar="استكشف أنشطة الفرع ←" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>

  <!-- Interactive Leader Bio Modal -->
  <div 
    id="leader-modal" 
    class="fixed inset-0 z-50 bg-stone-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4"
  >
    <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 space-y-4 shadow-2xl border border-stone-200 relative">
      <button 
        id="leader-modal-close" 
        type="button" 
        class="absolute top-4 right-4 text-stone-400 hover:text-stone-700 text-2xl font-bold cursor-pointer"
      >
        ×
      </button>

      <div class="text-center pt-2">
        <h3 id="modal-leader-name" class="text-xl sm:text-2xl font-black text-stone-900"></h3>
        <p id="modal-leader-role" class="text-xs uppercase font-bold text-amber-800 tracking-wider mt-1"></p>
      </div>

      <div class="py-2 border-y border-stone-100">
        <p id="modal-leader-bio" class="text-xs sm:text-sm text-stone-700 leading-relaxed"></p>
      </div>

      <div class="pt-2 text-center">
        <button 
          id="modal-leader-ok" 
          type="button" 
          class="btn-scout-primary text-xs uppercase tracking-wider w-full py-2.5"
        >
          <T en="Close" ar="إغلاق" />
        </button>
      </div>
    </div>
  </div>

</div>

<script>
  const cards = document.querySelectorAll('.leader-card');
  const modal = document.getElementById('leader-modal');
  const modalName = document.getElementById('modal-leader-name');
  const modalRole = document.getElementById('modal-leader-role');
  const modalBio = document.getElementById('modal-leader-bio');
  const closeBtn = document.getElementById('leader-modal-close');
  const okBtn = document.getElementById('modal-leader-ok');

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const isArabic = document.documentElement.lang === 'ar';
      
      const name = isArabic 
        ? card.getAttribute('data-name-ar') || card.getAttribute('data-name') 
        : card.getAttribute('data-name');
      
      const role = isArabic 
        ? card.getAttribute('data-role-ar') || card.getAttribute('data-role') 
        : card.getAttribute('data-role');
      
      const bio = isArabic 
        ? card.getAttribute('data-bio-ar') || card.getAttribute('data-bio') 
        : card.getAttribute('data-bio');

      if (modalName) modalName.textContent = name || '';
      if (modalRole) modalRole.textContent = role || '';
      if (modalBio) modalBio.textContent = bio || '';

      modal?.classList.remove('hidden');
    });
  });

  closeBtn?.addEventListener('click', () => modal?.classList.add('hidden'));
  okBtn?.addEventListener('click', () => modal?.classList.add('hidden'));
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.classList.add('hidden');
  });
</script>
