---
import { leadershipData } from '../data/leadership';
---

<div class="py-8">
  
  <!-- Interactive View Toggle (Tree View vs List View on smaller screens) -->
  <div class="max-w-5xl mx-auto">
    
    <!-- LEVEL 1: High Leadership (Chef de Groupe & Chaplain) -->
    <div class="flex flex-col items-center">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-xl w-full">
        <!-- Chef de Groupe Card -->
        <div class="bg-sand-100 rounded-2xl p-6 border-2 border-cedar-800 shadow-tactile text-center relative group hover:-translate-y-1 transition-transform">
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-cedar-800 text-gold-400 text-xs font-bold uppercase tracking-wider px-3 py-0.5 rounded-full shadow-sm">
            Top Leadership
          </div>
          <div class="w-16 h-16 rounded-full bg-cedar-800 text-sand-50 mx-auto mb-3 flex items-center justify-center font-serif text-2xl font-bold shadow-inner border-2 border-gold-400">
            CG
          </div>
          <h4 class="font-serif font-bold text-xl text-cedar-950">{leadershipData.groupLeader.name}</h4>
          <p class="text-xs uppercase tracking-wider font-semibold text-cedar-700 mt-0.5">{leadershipData.groupLeader.role}</p>
          <p class="text-xs text-stone-600 mt-2">{leadershipData.groupLeader.bio}</p>
          <span class="inline-block mt-3 text-[11px] font-semibold text-stone-500 bg-sand-200/70 px-2.5 py-0.5 rounded-full">
            {leadershipData.groupLeader.yearsInGroup}
          </span>
        </div>

        <!-- Chaplain / Aumonier Card -->
        <div class="bg-sand-100 rounded-2xl p-6 border-2 border-stone-400 shadow-tactile text-center relative group hover:-translate-y-1 transition-transform">
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-stone-700 text-white text-xs font-bold uppercase tracking-wider px-3 py-0.5 rounded-full shadow-sm">
            Spiritual Guide
          </div>
          <div class="w-16 h-16 rounded-full bg-stone-700 text-sand-50 mx-auto mb-3 flex items-center justify-center font-serif text-2xl font-bold shadow-inner border-2 border-stone-300">
            ✝
          </div>
          <h4 class="font-serif font-bold text-xl text-stone-900">{leadershipData.chaplain.name}</h4>
          <p class="text-xs uppercase tracking-wider font-semibold text-stone-600 mt-0.5">{leadershipData.chaplain.role}</p>
          <p class="text-xs text-stone-600 mt-2">{leadershipData.chaplain.bio}</p>
          <span class="inline-block mt-3 text-[11px] font-semibold text-stone-500 bg-sand-200/70 px-2.5 py-0.5 rounded-full">
            {leadershipData.chaplain.yearsInGroup}
          </span>
        </div>
      </div>

      <!-- Vertical Connecting Stem 1 -->
      <div class="w-0.5 h-10 bg-cedar-700"></div>
      <div class="w-3 h-3 rounded-full bg-cedar-800 -mt-1.5"></div>

      <!-- LEVEL 2: Group Council (Conseil de Groupe) -->
      <div class="mt-4 w-full">
        <div class="text-center mb-4">
          <span class="bg-cedar-100 text-cedar-900 border border-cedar-300 text-xs uppercase tracking-wider font-bold px-4 py-1 rounded-full">
            Conseil de Groupe (Group Council)
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {leadershipData.council.map(member => (
            <div class="bg-white rounded-xl p-4 border border-cedar-800/15 shadow-sm hover:shadow-md transition-shadow text-center">
              <div class="w-10 h-10 rounded-full bg-sand-200 text-cedar-900 font-bold mx-auto mb-2 flex items-center justify-center text-xs">
                {member.name.split(' ').map(n => n[0]).slice(0, 2).join('')}
              </div>
              <h5 class="font-bold text-sm text-stone-900">{member.name}</h5>
              <p class="text-xs font-semibold text-cedar-700">{member.role}</p>
              <p class="text-[11px] text-stone-500 mt-1.5 leading-snug">{member.bio}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Vertical Connecting Stem 2 -->
      <div class="w-0.5 h-12 bg-cedar-700 mt-4"></div>
      
      <!-- Horizontal Connecting Branch Bar across the 3 Units -->
      <div class="hidden md:block w-3/4 h-0.5 bg-cedar-700 relative">
        <!-- Dots at branch ends and center -->
        <div class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-amber-600"></div>
        <div class="absolute left-1/2 top-1/2 -translate-y-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-emerald-600"></div>
        <div class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/2 w-3 h-3 rounded-full bg-sky-600"></div>
      </div>

      <!-- LEVEL 3 & 4: Section Branches & Assistant Leaders -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6 w-full">
        {leadershipData.sectionBranches.map(branch => (
          <div class={`rounded-2xl p-5 border-2 shadow-sm ${branch.color} flex flex-col justify-between`}>
            <div>
              <!-- Branch Header -->
              <div class="text-center pb-3 border-b border-stone-200/70">
                <span class="text-xs font-bold uppercase tracking-wider text-stone-700">
                  Unit Branch
                </span>
                <h4 class="font-serif font-bold text-lg text-cedar-950 mt-0.5">
                  {branch.branchName}
                </h4>
              </div>

              <!-- Main Unit Leader -->
              <div class="space-y-4 pt-4">
                {branch.leaders.map(leader => (
                  <div class="space-y-3">
                    <div class="bg-white/95 rounded-xl p-4 border border-stone-200 text-center shadow-sm">
                      <div class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-stone-100 text-stone-700 mb-1">
                        Chef d'Unité
                      </div>
                      <h5 class="font-bold text-sm text-stone-900">{leader.name}</h5>
                      <p class="text-xs font-semibold text-cedar-700">{leader.role}</p>
                      <p class="text-xs text-stone-600 mt-1">{leader.bio}</p>
                    </div>

                    <!-- Assistants (Level 4 of tree) -->
                    {leader.children && leader.children.length > 0 && (
                      <div class="space-y-2 pt-2">
                        <div class="flex items-center justify-center gap-2 text-[11px] font-bold uppercase tracking-wider text-stone-500">
                          <span class="w-4 h-px bg-stone-300"></span>
                          <span>Chefs Adjoints</span>
                          <span class="w-4 h-px bg-stone-300"></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 gap-2">
                          {leader.children.map(child => (
                            <div class="bg-white/80 rounded-lg p-2.5 border border-stone-200/80 text-center text-xs">
                              <div class="font-semibold text-stone-900">{child.name}</div>
                              <div class="text-[11px] text-stone-500">{child.role}</div>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>

            <!-- View Section link -->
            <div class="pt-5 text-center">
              <a 
                href={`/sections#${branch.branchId}`}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-cedar-800 hover:text-cedar-950 underline"
              >
                <span>Explore {branch.branchName.split('(')[0]} activities</span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>

  </div>
</div>
