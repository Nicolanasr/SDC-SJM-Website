---
import { siteConfig } from '../data/siteConfig';
---

<div class="rounded-3xl bg-white border-2 border-stone-300 p-8 sm:p-12 shadow-sm my-12">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    
    <div class="lg:col-span-8 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-amber-100 text-amber-900 border border-amber-300">
        <span>HOW TO JOIN</span>
        <span>•</span>
        <span>ZERO PAPERWORK TO START</span>
      </div>

      <h3 class="text-3xl sm:text-4xl font-black text-stone-900 tracking-tight">
        Joining is as simple as showing up.
      </h3>

      <p class="text-stone-600 text-base sm:text-lg leading-relaxed max-w-2xl">
        There are no registration portals, entry exams, or upfront commitments. Just come by with your child on <strong>any Saturday at 3:00 PM</strong> at the Saint Jean Marc courtyard. Have a casual chat with the chefs, let your child play with their age group, and decide together if our family feels right for them.
      </p>

      <div class="pt-2 flex items-center gap-4 text-xs font-bold text-stone-500 uppercase tracking-wider">
        <span>✓ No commitment required</span>
        <span>•</span>
        <span>✓ All units welcome (Ages 4–24)</span>
        <span>•</span>
        <span>✓ Casual clothes ok</span>
      </div>
    </div>

    <div class="lg:col-span-4 flex flex-col gap-3 justify-center">
      <a 
        href={`https://wa.me/${siteConfig.contact.phoneRaw}?text=${encodeURIComponent('Hello Chef! I am planning to come with my child this Saturday at 3:00 PM. See you then!')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-scout-gold text-center text-sm"
      >
        Tell Us You're Coming (WhatsApp)
      </a>

      <a 
        href="/#meeting"
        class="btn-scout-outline text-center text-sm"
      >
        Meeting Time & Location Guide
      </a>
    </div>

  </div>
</div>
