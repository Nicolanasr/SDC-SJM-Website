---
import { siteConfig } from '../data/siteConfig';
---

<footer class="bg-cedar-950 text-sand-100 pt-16 pb-12 border-t border-cedar-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-cedar-800/60">
      
      <!-- Brand & Mission -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-cedar-800 text-sand-50 flex items-center justify-center font-bold text-lg border border-cedar-700">
            <svg class="w-5 h-5 text-gold-400" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L6 8h3.5L5 14h4.5L3 20h18l-6.5-6h4.5L14.5 8H18L12 2zM11 20v2h2v-2h-2z" />
            </svg>
          </div>
          <div>
            <div class="font-serif font-bold text-lg text-sand-50 leading-tight">
              {siteConfig.groupName}
            </div>
            <div class="text-xs uppercase tracking-wider text-gold-400 font-medium">
              {siteConfig.tagline}
            </div>
          </div>
        </div>
        <p class="text-sm text-sand-200/80 leading-relaxed">
          Founded on May 5, 1977. Serving youth through fellowship, outdoor woodcraft, personal character, and civic service at Saint Jean Marc, Byblos.
        </p>
        <div class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-cedar-900 text-gold-400 border border-cedar-800">
          Toujours Prêt • Always Prepared
        </div>
      </div>

      <!-- Quick Navigation -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-gold-400 mb-4 font-sans">
          Explore
        </h4>
        <ul class="space-y-2.5 text-sm text-sand-200/80 font-medium">
          <li><a href="/" class="hover:text-sand-50 transition-colors">Home</a></li>
          <li><a href="/#history" class="hover:text-sand-50 transition-colors">Our 1977 Heritage</a></li>
          <li><a href="/sections" class="hover:text-sand-50 transition-colors">Sections & Age Units</a></li>
          <li><a href="/events" class="hover:text-sand-50 transition-colors">Upcoming Events & Camps</a></li>
          <li><a href="/leadership" class="hover:text-sand-50 transition-colors">Leadership Hierarchy Tree</a></li>
          <li><a href="/gallery" class="hover:text-sand-50 transition-colors">Photo Albums & Lightbox</a></li>
          <li><a href="/#faq" class="hover:text-sand-50 transition-colors">Parent FAQ</a></li>
        </ul>
      </div>

      <!-- Weekly Meeting Schedule -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-gold-400 mb-4 font-sans">
          Weekly Gathering
        </h4>
        <div class="bg-cedar-900/60 p-4 rounded-xl border border-cedar-800/80 space-y-2 text-sm">
          <div class="font-bold text-sand-100 flex items-center gap-2">
            <svg class="w-4 h-4 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span>{siteConfig.meetingSchedule.day}</span>
          </div>
          <div class="text-gold-300 font-semibold text-xs">
            {siteConfig.meetingSchedule.time}
          </div>
          <p class="text-xs text-sand-300/80 leading-relaxed pt-1">
            {siteConfig.meetingSchedule.locationDetails}
          </p>
          <div class="pt-2">
            <a 
              href={`https://maps.google.com/?q=${siteConfig.meetingSchedule.googleMapsQuery}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs text-gold-400 hover:text-gold-300 underline font-semibold"
            >
              <span>View location on Google Maps</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Contact & WhatsApp -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-gold-400 mb-4 font-sans">
          Get In Touch
        </h4>
        <ul class="space-y-3 text-sm text-sand-200/80">
          <li class="flex items-center gap-3">
            <a 
              href={`https://wa.me/${siteConfig.contact.phoneRaw}?text=${encodeURIComponent(siteConfig.contact.whatsappMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-emerald-800/80 hover:bg-emerald-700 text-white font-semibold text-xs border border-emerald-600 transition-colors"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.54 2.112.822 3.19.822 3.181 0 5.767-2.587 5.768-5.766.001-3.182-2.585-5.768-5.768-5.768zm0-2c4.284 0 7.768 3.484 7.768 7.768 0 4.283-3.484 7.767-7.768 7.767-1.328 0-2.585-.341-3.69-.941l-4.341 1.139 1.159-4.238c-.684-1.161-1.096-2.502-1.096-3.727 0-4.284 3.484-7.768 7.768-7.768z"/>
              </svg>
              <span>Direct WhatsApp Chat</span>
            </a>
          </li>
          <li>
            <a href={`tel:${siteConfig.contact.phoneDisplay}`} class="hover:text-sand-50 flex items-center gap-2">
              <svg class="w-4 h-4 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>{siteConfig.contact.phoneDisplay}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${siteConfig.contact.email}`} class="hover:text-sand-50 flex items-center gap-2">
              <svg class="w-4 h-4 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span class="break-all">{siteConfig.contact.email}</span>
            </a>
          </li>
          <li class="pt-2 text-xs text-sand-400">
            Paroisse Saint Jean Marc, Byblos (Jbeil), Lebanon
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright & Scout Signoff -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-sand-300/70 gap-4">
      <div>
        © 1977 – {new Date().getFullYear()} {siteConfig.groupName} – {siteConfig.tagline}. All rights reserved.
      </div>
      <div class="flex items-center gap-4 text-xs font-medium">
        <span>Scouts du Liban / Les Scouts des Cèdres</span>
        <span>•</span>
        <a href="#top" class="hover:text-sand-100 underline">Back to Top ↑</a>
      </div>
    </div>
  </div>
</footer>
