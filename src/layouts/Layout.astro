---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { siteConfig } from '../data/siteConfig';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = `${siteConfig.groupName} – ${siteConfig.tagline}`, 
  description = "Official website of Scout Des Cèdres - Groupe Saint Jean Marc. Founded May 5, 1977. Weekly scout meetings every Saturday at Saint Jean Marc, Byblos, Lebanon."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-[#FAF7F2] text-stone-800 min-h-screen flex flex-col selection:bg-cedar-800 selection:text-sand-50" id="top">
    
    <Header />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />

    <!-- Fixed Floating WhatsApp Quick-Button -->
    <FloatingWhatsApp />

  </body>
</html>
